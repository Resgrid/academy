    {
      "id": "03",
      "title": "Set a fixed center and hide labels",
      "kind": "operational",
      "start": 50.96,
      "end": 75.619,
      "screens": [
        {
          "screenshot_id": "005-fixed-zoom-and-hide-labels",
          "start": 50.96,
          "end": 57.24
        },
        {
          "screenshot_id": "006-chicago-center-and-save",
          "start": 57.24,
          "end": 65.77
        },
        {
          "screenshot_id": "005-fixed-zoom-and-hide-labels",
          "start": 65.77,
          "end": 68.539
        },
        {
          "screenshot_id": "009-verified-fixed-map-labels-hidden",
          "start": 68.539,
          "end": 75.619
        }
      ],
      "captions": [
        {
          "start": 50.96,
          "end": 54.41,
          "text": "For a board that should stay centered on the same area, turn",
          "cue": 16,
          "screenshot_id": "005-fixed-zoom-and-hide-labels",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 54.41,
          "end": 56.769,
          "text": "off Zoom Out to Show All Pins.",
          "cue": 17,
          "screenshot_id": "005-fixed-zoom-and-hide-labels",
          "required_labels": [
            "Zoom Out to Show All Pins"
          ],
          "instructional": true,
          "spoken_references": {
            "Zoom Out to Show All Pins": "Zoom Out to Show All Pins"
          }
        },
        {
          "start": 57.24,
          "end": 60.59,
          "text": "Enter a zoom and set the center with latitude and longitude.",
          "cue": 18,
          "screenshot_id": "006-chicago-center-and-save",
          "required_labels": [
            "Latitude"
          ],
          "instructional": true,
          "spoken_references": {
            "Latitude": "latitude"
          }
        },
        {
          "start": 61.05,
          "end": 62.64,
          "text": "We use a Chicago center.",
          "cue": 19,
          "screenshot_id": "006-chicago-center-and-save",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 63.01,
          "end": 65.31,
          "text": "Keep the minus sign in the west longitude.",
          "cue": 20,
          "screenshot_id": "006-chicago-center-and-save",
          "required_labels": [
            "Longitude"
          ],
          "instructional": true,
          "spoken_references": {
            "Longitude": "longitude"
          }
        },
        {
          "start": 65.77,
          "end": 68.32,
          "text": "Turn on Hide Labels to simplify the view.",
          "cue": 21,
          "screenshot_id": "005-fixed-zoom-and-hide-labels",
          "required_labels": [
            "Hide Labels"
          ],
          "instructional": true,
          "spoken_references": {
            "Hide Labels": "Hide Labels"
          }
        },
        {
          "start": 68.539,
          "end": 72.099,
          "text": "After saving, check that the frame covers the area you intended.",
          "cue": 22,
          "screenshot_id": "009-verified-fixed-map-labels-hidden",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 72.499,
          "end": 75.23,
          "text": "Our first zoom is too tight to show the resources.",
          "cue": 23,
          "screenshot_id": "009-verified-fixed-map-labels-hidden",
          "required_labels": [],
          "instructional": false
        }
      ],
      "visual_required_labels": [
        "Zoom Out to Show All Pins",
        "Latitude",
        "Longitude",
        "Hide Labels"
      ],
