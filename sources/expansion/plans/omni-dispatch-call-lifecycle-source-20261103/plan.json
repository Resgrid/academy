      "captions": [
        {
          "start": 0.029,
          "end": 4.25,
          "text": "In Omni Dispatch, open New Call for a community outreach standby.",
          "cue": 1,
          "screenshot_id": "001-call-details",
          "required_labels": [
            "New Call"
          ],
          "instructional": true,
          "spoken_references": {
            "New Call": "New Call"
          }
        },
        {
          "start": 4.88,
          "end": 8.56,
          "text": "Enter a name your team will recognize and use Nature to describe",
          "cue": 2,
          "screenshot_id": "001-call-details",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 8.56,
          "end": 9.899000000000001,
          "text": "what responders need to know.",
          "cue": 3,
          "screenshot_id": "001-call-details",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 10.34,
          "end": 12.829,
          "text": "This exercise uses Medical and Routine.",
          "cue": 4,
          "screenshot_id": "001-call-details",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 13.279,
          "end": 16.62,
          "text": "Choose the type and priority your department uses for this work.",
          "cue": 5,
          "screenshot_id": "001-call-details",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 16.759,
          "end": 21.87,
          "text": "On the location section, select GPS and enter the latitude and longitude.",
          "cue": 6,
          "screenshot_id": "002-call-location",
          "required_labels": [
            "GPS Coordinates"
          ],
          "instructional": true,
          "spoken_references": {
            "GPS Coordinates": "GPS"
          }
        },
        {
          "start": 22.359,
          "end": 24.43,
          "text": "Check the map against your intended site.",
          "cue": 7,
          "screenshot_id": "002-call-location",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 24.869,
          "end": 28.299,
          "text": "A search team can use coordinates for a trail rendezvous, and an",
          "cue": 8,
          "screenshot_id": "002-call-location",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 28.299,
          "end": 31.39,
          "text": "industrial response team can use them for an access gate.",
          "cue": 9,
          "screenshot_id": "002-call-location",
          "required_labels": [],
          "instructional": false
        }
      ],
