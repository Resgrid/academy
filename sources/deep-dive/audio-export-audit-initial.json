      "silent_cues": [
        {
          "cue": 76,
          "start": "00:04:23,200",
          "end": "00:04:28,400",
          "text": "Creating a unit status set does not automatically apply it to every unit.",
          "rms": 3.654210600166349e-08
        },
        {
          "cue": 77,
          "start": "00:04:28,400",
          "end": "00:04:34,400",
          "text": "Open Types, find the unit type, and choose the set in Actions, Custom Unit Statuses.",
          "rms": 0.0
        },
        {
          "cue": 78,
          "start": "00:04:34,400",
          "end": "00:04:38,800",
          "text": "We assign the completed Field Response set to Rescue and save.",
          "rms": 0.0
        },
        {
          "cue": 79,
          "start": "00:04:38,800",
          "end": "00:04:43,599",
          "text": "That choice affects every unit with the Rescue type in this department.",
          "rms": 0.0
        },
        {
          "cue": 80,
          "start": "00:04:43,599",
          "end": "00:04:46,800",
          "text": "Our Squad Three demonstration resource has that type.",
          "rms": 0.0
        },
        {
          "cue": 81,
          "start": "00:04:46,800",
          "end": "00:04:50,400",
          "text": "Return to Units and open its Set Status dialog.",
          "rms": 0.0
        },
        {
          "cue": 82,
          "start": "00:04:50,400",
          "end": "00:04:54,000",
          "text": "The picker now shows Ready for assignment, Searching assigned",
          "rms": 0.0
        },
        {
          "cue": 83,
          "start": "00:04:54,000",
          "end": "00:04:55,599",
          "text": "area and Unavailable, maintenance.",
          "rms": 0.0
        },
        {
          "cue": 84,
          "start": "00:04:55,599",
          "end": "00:04:58,400",
          "text": "Other unit types retain their own sets.",
          "rms": 0.0
        },
        {
          "cue": 85,
          "start": "00:04:58,400",
          "end": "00:05:03,600",
          "text": "This lets a mixed department give a search team, patrol vehicle, ambulance and",
          "rms": 0.0
        },
        {
          "cue": 86,
          "start": "00:05:03,600",
          "end": "00:05:05,200",
          "text": "industrial asset appropriate lifecycles.",
          "rms": 0.0
        },
        {
          "cue": 87,
          "start": "00:05:05,200",
          "end": "00:05:09,200",
          "text": "Review type membership before changing the shared set; a type-wide",
          "rms": 0.0
        },
        {
          "cue": 88,
          "start": "00:05:09,200",
          "end": "00:05:13,600",
          "text": "assignment has a wider effect than changing one unit’s current status.",
          "rms": 1.123017931210268e-07
