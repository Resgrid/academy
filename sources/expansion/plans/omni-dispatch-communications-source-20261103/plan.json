      "captions": [
        {
          "start": 22.029,
          "end": 24.289,
          "text": "Open Chat and check the section you are in.",
          "cue": 7,
          "screenshot_id": "003-chat-directory",
          "required_labels": [
            "Chat"
          ],
          "instructional": true,
          "spoken_references": {
            "Chat": "Chat"
          }
        },
        {
          "start": 24.7,
          "end": 26.08,
          "text": "Direct Messages, Channels",
          "cue": 8,
          "screenshot_id": "003-chat-directory",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 26.08,
          "end": 29.269,
          "text": "and Incidents organize conversations by audience.",
          "cue": 9,
          "screenshot_id": "009-incident-conversation-list",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 29.679,
          "end": 34.109,
          "text": "Select Academy readiness under Channels to review its existing message.",
          "cue": 10,
          "screenshot_id": "004-chat-thread",
          "required_labels": [
            "TRAINING — Academy readiness"
          ],
          "instructional": true,
          "spoken_references": {
            "TRAINING — Academy readiness": "Academy readiness"
          }
        },
        {
          "start": 34.47,
          "end": 37.89,
          "text": "A community outreach team can use a shared channel to coordinate",
          "cue": 11,
          "screenshot_id": "004-chat-thread",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 37.89,
          "end": 39.61,
          "text": "the staff handoff for a standby.",
          "cue": 12,
          "screenshot_id": "004-chat-thread",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 39.84,
          "end": 43.639,
          "text": "Check the channel name above the conversation before typing a message.",
          "cue": 13,
          "screenshot_id": "004-chat-thread",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 43.99,
          "end": 47.16,
          "text": "The composer has an Urgent switch and a Send button.",
          "cue": 14,
          "screenshot_id": "005-chat-composer",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 47.6,
          "end": 50.59,
          "text": "In this exercise the equipment handoff stays unsent.",
          "cue": 15,
          "screenshot_id": "005-chat-composer",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 51.209,
          "end": 55.329,
          "text": "A security dispatcher can use the same check before sharing a shift update.",
          "cue": 16,
          "screenshot_id": "005-chat-composer",
          "required_labels": [],
          "instructional": false
        }
      ],
