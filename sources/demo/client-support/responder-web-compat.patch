+import { useColorScheme } from 'nativewind';
+import React from 'react';
+import { StyleSheet, type StyleProp, type ViewStyle } from 'react-native';
+
+interface BrowserWebViewProps {
+  source?: { html?: string; uri?: string };
+  style?: StyleProp<ViewStyle>;
+  testID?: string;
+  accessibilityLabel?: string;
+  scrollEnabled?: boolean;
+}
+
+// Recording-only browser adapter: render the existing API-backed rich-text HTML
+// in a sandboxed iframe. No invented content, script execution, or native bridge.
+export const WebView: React.FC<BrowserWebViewProps> = ({ source, style, testID, accessibilityLabel, scrollEnabled = true }) => {
+  const { colorScheme } = useColorScheme();
+  // An iframe has its own canvas; match the scheme used by the native rich-text
+  // generator so its existing light text is not rendered on a white canvas.
+  const scheme = `<meta name="color-scheme" content="${colorScheme === 'dark' ? 'dark' : 'light'}">`;
+  const html = source?.html ? (source.html.includes('</head>') ? source.html.replace('</head>', `${scheme}</head>`) : `${scheme}${source.html}`) : undefined;
+  return (
+  <iframe
+    title={accessibilityLabel || 'Application rich text'}
+    srcDoc={html}
+    src={source?.html ? undefined : source?.uri}
+    sandbox="allow-same-origin"
+    scrolling={scrollEnabled ? 'auto' : 'no'}
+    data-testid={testID}
+    style={{ border: 0, width: '100%', ...(StyleSheet.flatten(style) as React.CSSProperties) }}
+  />
+  );
+};
+
+export default WebView;
