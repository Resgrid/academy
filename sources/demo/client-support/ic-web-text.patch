@@ -0,0 +1,37 @@
+import React from 'react';
+
+export interface WebCameraSettings {
+  centerCoordinate?: [number, number];
+  zoomLevel?: number;
+  heading?: number;
+  pitch?: number;
+}
+
+export interface WebCameraDeclaration extends WebCameraSettings {
+  defaultSettings?: WebCameraSettings;
+  bounds?: { ne: [number, number]; sw: [number, number] };
+  children?: React.ReactNode;
+}
+
+/** Native Camera defaultSettings remain the initial values until a controlled prop replaces them. */
+export function resolveWebCameraSettings(props: WebCameraDeclaration): WebCameraSettings {
+  return {
+    centerCoordinate: props.centerCoordinate ?? props.defaultSettings?.centerCoordinate,
+    zoomLevel: props.zoomLevel ?? props.defaultSettings?.zoomLevel,
+    heading: props.heading ?? props.defaultSettings?.heading,
+    pitch: props.pitch ?? props.defaultSettings?.pitch,
+  };
+}
+
+/** Use the caller's declared camera before map construction and before department fallback recentering. */
+export function findWebCameraDeclaration(children: React.ReactNode, cameraType: React.ElementType): WebCameraDeclaration | undefined {
+  for (const child of React.Children.toArray(children)) {
+    if (!React.isValidElement<WebCameraDeclaration>(child)) continue;
+    if (child.type === cameraType) return child.props;
+    if (child.type === React.Fragment) {
+      const nested = findWebCameraDeclaration(child.props.children, cameraType);
+      if (nested) return nested;
+    }
+  }
+  return undefined;
+}
