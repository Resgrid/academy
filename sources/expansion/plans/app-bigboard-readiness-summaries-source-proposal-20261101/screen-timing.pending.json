  "cues": [
    {
      "cue": 1,
      "scene_id": "01",
      "screenshot_id": "001-summary-widget-choices",
      "start": 0.0,
      "end": 4.15,
      "text": "Big Board gives a duty supervisor or department coordinator a shared"
    },
    {
      "cue": 2,
      "scene_id": "01",
      "screenshot_id": "001-summary-widget-choices",
      "start": 4.15,
      "end": 5.989,
      "text": "view of operational information."
    },
    {
      "cue": 3,
      "scene_id": "01",
      "screenshot_id": "001-summary-widget-choices",
      "start": 6.449,
      "end": 11.06,
      "text": "From the board, use the plus icon at the upper right to open Add Widget."
    },
    {
      "cue": 4,
      "scene_id": "01",
      "screenshot_id": "001-summary-widget-choices",
      "start": 11.47,
      "end": 16.86,
      "text": "Choose Personnel Status Summary, Personnel Staffing Summary and Units Summary."
    },
    {
      "cue": 5,
      "scene_id": "01",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 17.329,
      "end": 20.489,
      "text": "After adding them, scroll to the three rendered panels."
    },
    {
      "cue": 6,
      "scene_id": "01",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 20.94,
      "end": 24.989,
      "text": "This fictional department already has calls, units and a personnel"
    },
    {
      "cue": 7,
      "scene_id": "01",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 24.989,
      "end": 26.52,
      "text": "list elsewhere on its board."
    },
    {
      "cue": 8,
      "scene_id": "01",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 26.909,
      "end": 31.09,
      "text": "These summary panels provide counts that you can compare with those detailed views."
    },
    {
      "cue": 9,
      "scene_id": "02",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 31.28,
      "end": 35.299,
      "text": "Read Personnel Status and Personnel Staffing as separate measures."
    },
    {
      "cue": 10,
      "scene_id": "02",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 35.66,
      "end": 39.229,
      "text": "Here, Standing By shows fourteen in the status panel."
    },
    {
      "cue": 11,
      "scene_id": "02",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 39.639,
      "end": 44.099,
      "text": "Staffing shows three Available, one Delayed, two Unavailable,"
    },
    {
      "cue": 12,
      "scene_id": "02",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 44.439,
      "end": 46.87,
      "text": "zero Committed and eight On Shift."
    },
    {
      "cue": 13,
      "scene_id": "02",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 47.28,
      "end": 50.749,
      "text": "The same fourteen people are being described in different ways."
    },
    {
      "cue": 14,
      "scene_id": "02",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 51.109,
      "end": 54.47,
      "text": "A Standing By status therefore does not mean that fourteen"
    },
    {
      "cue": 15,
      "scene_id": "02",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 54.47,
      "end": 56.37,
      "text": "people have Available staffing."
    },
    {
      "cue": 16,
      "scene_id": "02",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 56.739,
      "end": 60.38,
      "text": "Keep both panels visible when discussing the department's current staffing"
    },
    {
      "cue": 17,
      "scene_id": "02",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 60.38,
      "end": 64.259,
      "text": "picture, rather than treating one count as a substitute for the other."
    },
    {
      "cue": 18,
      "scene_id": "03",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 64.459,
      "end": 67.769,
      "text": "The colored personnel-status counts are difficult to distinguish"
    },
    {
      "cue": 19,
      "scene_id": "03",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 67.769,
      "end": 69.189,
      "text": "against this dark background."
    },
    {
      "cue": 20,
      "scene_id": "03",
      "screenshot_id": "003-rendered-readiness-summaries",
      "start": 69.619,
      "end": 73.57,
      "text": "Use the gear icon at the upper right to open configuration, then"
    },
    {
      "cue": 21,
      "scene_id": "03",
      "screenshot_id": "004-personnel-status-colors-disabled",
      "start": 73.57,
      "end": 75.559,
      "text": "select Personnel Status Widget."
    },
    {
      "cue": 22,
      "scene_id": "03",
      "screenshot_id": "004-personnel-status-colors-disabled",
      "start": 76.03,
      "end": 80.049,
      "text": "On Personnel Status Summary Widget, turn Show Colors off."
    },
    {
      "cue": 23,
      "scene_id": "03",
      "screenshot_id": "004-personnel-status-colors-disabled",
      "start": 80.4,
      "end": 83.949,
      "text": "This example keeps Font Size at fourteen points, with width and"
    },
    {
      "cue": 24,
      "scene_id": "03",
      "screenshot_id": "004-personnel-status-colors-disabled",
      "start": 83.949,
      "end": 86.17,
      "text": "height both set to four grid units."
    },
    {
      "cue": 25,
      "scene_id": "03",
      "screenshot_id": "004-personnel-status-colors-disabled",
      "start": 86.559,
      "end": 88.67,
      "text": "Select Save and return to the board."
    },
    {
      "cue": 26,
      "scene_id": "03",
      "screenshot_id": "005-neutral-status-counts-result",
      "start": 89.07,
      "end": 92.9,
      "text": "The Personnel Status numbers now use neutral light text, making"
    },
    {
      "cue": 27,
      "scene_id": "03",
      "screenshot_id": "005-neutral-status-counts-result",
      "start": 92.9,
      "end": 94.67,
      "text": "the zero values easier to see."
    },
    {
      "cue": 28,
      "scene_id": "04",
      "screenshot_id": "005-neutral-status-counts-result",
      "start": 94.829,
      "end": 98.109,
      "text": "In Personnel Staffing, compare all five rows."
    },
    {
      "cue": 29,
      "scene_id": "04",
      "screenshot_id": "005-neutral-status-counts-result",
      "start": 98.5,
      "end": 103.93,
      "text": "Available is three, Delayed is one, Unavailable is two, Committed"
    },
    {
      "cue": 30,
      "scene_id": "04",
      "screenshot_id": "005-neutral-status-counts-result",
      "start": 103.959,
      "end": 106.409,
      "text": "is zero and On Shift is eight."
    },
    {
      "cue": 31,
      "scene_id": "04",
      "screenshot_id": "005-neutral-status-counts-result",
      "start": 106.919,
      "end": 111.08,
      "text": "These totals describe the staffing values currently reported for the demo roster."
    },
    {
      "cue": 32,
      "scene_id": "04",
      "screenshot_id": "005-neutral-status-counts-result",
      "start": 111.49,
      "end": 115.24,
      "text": "The panel does not identify which individuals make up each count."
    },
    {
      "cue": 33,
      "scene_id": "04",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 115.689,
      "end": 119.629,
      "text": "Use it to spot a staffing question, then consult the personnel details"
    },
    {
      "cue": 34,
      "scene_id": "04",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 119.629,
      "end": 121.16,
      "text": "before making an assignment."
    },
    {
      "cue": 35,
      "scene_id": "04",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 121.57,
      "end": 125.98,
      "text": "A count alone does not tell you a person's qualifications, current location"
    },
    {
      "cue": 36,
      "scene_id": "04",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 126.019,
      "end": 128.309,
      "text": "or suitability for a particular task."
    },
    {
      "cue": 37,
      "scene_id": "05",
      "screenshot_id": "005-neutral-status-counts-result",
      "start": 128.509,
      "end": 132.67,
      "text": "Units Summary shows eight total units, six Available, one"
    },
    {
      "cue": 38,
      "scene_id": "05",
      "screenshot_id": "005-neutral-status-counts-result",
      "start": 132.67,
      "end": 134.88,
      "text": "Responding and zero On Scene."
    },
    {
      "cue": 39,
      "scene_id": "05",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 135.3,
      "end": 139.839,
      "text": "Scroll to the detailed Units table to see the individual names and State values."
    },
    {
      "cue": 40,
      "scene_id": "05",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 140.219,
      "end": 144.879,
      "text": "Squad Three is Responding, Ambulance Sixty One is Released, and Reserve"
    },
    {
      "cue": 41,
      "scene_id": "05",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 144.92,
      "end": 147.0,
      "text": "Engine Fifty One is Out of Service."
    },
    {
      "cue": 42,
      "scene_id": "05",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 147.359,
      "end": 148.949,
      "text": "Other rows say Available."
    },
    {
      "cue": 43,
      "scene_id": "05",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 149.35,
      "end": 153.23,
      "text": "The summary groups underlying status categories, so its Available"
    },
    {
      "cue": 44,
      "scene_id": "05",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 153.23,
      "end": 156.84,
      "text": "number is not simply a count of rows containing that exact word."
    },
    {
      "cue": 45,
      "scene_id": "05",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 157.18,
      "end": 160.619,
      "text": "Review the detailed states when selecting a specific resource."
    },
    {
      "cue": 46,
      "scene_id": "06",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 160.799,
      "end": 164.919,
      "text": "The Units table also includes Station, Type and Updated."
    },
    {
      "cue": 47,
      "scene_id": "06",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 165.37,
      "end": 169.97,
      "text": "In this recorded example, several unit updates are four, five or seven"
    },
    {
      "cue": 48,
      "scene_id": "06",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 169.97,
      "end": 173.459,
      "text": "days old, while the two training vehicles show one minute ago."
    },
    {
      "cue": 49,
      "scene_id": "06",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 173.919,
      "end": 177.529,
      "text": "Those ages matter when interpreting a summary built from these states."
    },
    {
      "cue": 50,
      "scene_id": "06",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 177.859,
      "end": 182.17,
      "text": "A visible count does not establish that every underlying report is recent."
    },
    {
      "cue": 51,
      "scene_id": "06",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 182.57,
      "end": 186.76,
      "text": "Read Updated alongside State, and resolve stale information through your"
    },
    {
      "cue": 52,
      "scene_id": "06",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 186.76,
      "end": 190.379,
      "text": "department's normal status-reporting process before relying on the"
    },
    {
      "cue": 53,
      "scene_id": "06",
      "screenshot_id": "009-unit-list-behind-summary-counts",
      "start": 190.379,
      "end": 192.22,
      "text": "board for an operational decision."
    },
    {
      "cue": 54,
      "scene_id": "07",
      "screenshot_id": "008-reloaded-neutral-readiness-counts",
      "start": 192.45,
      "end": 196.229,
      "text": "After saving, reload the board and return to the summary panels."
    },
    {
      "cue": 55,
      "scene_id": "07",
      "screenshot_id": "008-reloaded-neutral-readiness-counts",
      "start": 196.55,
      "end": 199.28,
      "text": "The neutral personnel-status counts remain visible."
    },
    {
      "cue": 56,
      "scene_id": "07",
      "screenshot_id": "008-reloaded-neutral-readiness-counts",
      "start": 199.769,
      "end": 203.5,
      "text": "Reopen configuration and select Personnel Status Widget again."
    },
    {
      "cue": 57,
      "scene_id": "07",
      "screenshot_id": "010-fresh-session-saved-settings",
      "start": 203.939,
      "end": 207.929,
      "text": "Show Colors is still off, and the form still shows fourteen points"
    },
    {
      "cue": 58,
      "scene_id": "07",
      "screenshot_id": "010-fresh-session-saved-settings",
      "start": 207.96,
      "end": 209.74,
      "text": "and four-by-four grid dimensions."
    },
