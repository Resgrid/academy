    {
      "id": "03",
      "title": "Resize and verify the forecast",
      "kind": "operational",
      "start": 54.01,
      "end": 90.889,
      "screens": [
        {
          "screenshot_id": "004-resize-forecast-and-save",
          "start": 54.01,
          "end": 67.51
        },
        {
          "screenshot_id": "005-metric-chicago-forecast",
          "start": 67.51,
          "end": 83.99
        },
        {
          "screenshot_id": "006-weather-settings-reopened",
          "start": 83.99,
          "end": 90.889
        }
      ],
      "captions": [
        {
          "start": 54.01,
          "end": 56.14,
          "text": "Give the forecast room to breathe.",
          "cue": 18,
          "screenshot_id": "004-resize-forecast-and-save",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 56.739,
          "end": 62.199,
          "text": "In this example, we increase Width to five and Height to four, then select Save.",
          "cue": 19,
          "screenshot_id": "004-resize-forecast-and-save",
          "required_labels": [
            "Save"
          ],
          "instructional": true,
          "spoken_references": {
            "Save": "Save"
          }
        },
        {
          "start": 62.579,
          "end": 65.89,
          "text": "A larger tile makes it easier for a team to read the upcoming",
          "cue": 20,
          "screenshot_id": "004-resize-forecast-and-save",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 65.89,
          "end": 67.23,
          "text": "days from across a room.",
          "cue": 21,
          "screenshot_id": "004-resize-forecast-and-save",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 67.51,
          "end": 70.88,
          "text": "Back on the board, verify the city as well as the units.",
          "cue": 22,
          "screenshot_id": "005-metric-chicago-forecast",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 71.239,
          "end": 74.63,
          "text": "The Chicago widget now shows temperature in Celsius and wind",
          "cue": 23,
          "screenshot_id": "005-metric-chicago-forecast",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 74.63,
          "end": 76.15,
          "text": "speed in meters per second.",
          "cue": 24,
          "screenshot_id": "005-metric-chicago-forecast",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 76.549,
          "end": 80.2,
          "text": "The forecast rows give the team a quick way to compare the coming days.",
          "cue": 25,
          "screenshot_id": "005-metric-chicago-forecast",
          "required_labels": [
            "5-Day Forecast"
          ],
          "instructional": true,
          "spoken_references": {
            "5-Day Forecast": "forecast rows"
          }
        },
        {
          "start": 80.57,
          "end": 83.829,
          "text": "These are live readings, so the exact values will change.",
          "cue": 26,
          "screenshot_id": "005-metric-chicago-forecast",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 83.99,
          "end": 88.2,
          "text": "Reopen Weather Widget settings and check that Metric, the coordinates, and the",
          "cue": 27,
          "screenshot_id": "006-weather-settings-reopened",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 88.2,
          "end": 90.38,
          "text": "larger tile size survived the save.",
          "cue": 28,
          "screenshot_id": "006-weather-settings-reopened",
          "required_labels": [],
          "instructional": false
        }
      ],
      "visual_required_labels": [
        "Save",
        "5-Day Forecast"
      ],
