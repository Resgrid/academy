        "Steps": "Steps"
      },
      "instructional": true
    },
    {
      "start": 32.43,
      "end": 36.349,
      "text": "Change status is a separate section with its own Update status button.",
      "cue": 10,
      "scene_id": "02",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [
        "Change status",
        "Update status"
      ],
      "spoken_references": {
        "Change status": "Change status",
        "Update status": "Update status"
      },
      "instructional": true
    },
    {
      "start": 36.74,
      "end": 39.39,
      "text": "Log hours and Save hours are separate again.",
      "cue": 11,
      "scene_id": "02",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [
        "Log hours",
        "Save hours"
      ],
      "spoken_references": {
        "Log hours": "Log hours",
        "Save hours": "Save hours"
      },
      "instructional": true
    },
    {
