    {
      "id": "04",
      "title": "Widen the frame and verify the result",
      "kind": "operational",
      "start": 75.619,
      "end": 107.29941666666667,
      "screens": [
        {
          "screenshot_id": "010-fixed-zoom-with-visible-pin-area",
          "start": 75.619,
          "end": 79.759
        },
        {
          "screenshot_id": "011-verified-pins-visible-without-labels",
          "start": 79.759,
          "end": 107.29941666666667
        }
      ],
      "captions": [
        {
          "start": 75.619,
          "end": 79.389,
          "text": "Reopen Map settings and set the zoom to twelve, then save again.",
          "cue": 24,
          "screenshot_id": "010-fixed-zoom-with-visible-pin-area",
          "required_labels": [
            "Zoom Level: 12"
          ],
          "instructional": true,
          "spoken_references": {
            "Zoom Level: 12": "zoom to twelve"
          }
        },
        {
          "start": 79.759,
          "end": 82.45,
          "text": "The wider view keeps the fixed center while bringing the",
          "cue": 25,
          "screenshot_id": "011-verified-pins-visible-without-labels",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 82.45,
          "end": 84.19,
          "text": "training pins back into the frame.",
          "cue": 26,
          "screenshot_id": "011-verified-pins-visible-without-labels",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 84.429,
          "end": 87.519,
          "text": "Now the pins remain but their Resgrid names are hidden.",
          "cue": 27,
          "screenshot_id": "011-verified-pins-visible-without-labels",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 87.959,
          "end": 90.329,
          "text": "Street names from the basemap are still visible.",
          "cue": 28,
          "screenshot_id": "011-verified-pins-visible-without-labels",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 90.829,
          "end": 94.469,
          "text": "Some training pins share a location, so their icons overlap.",
          "cue": 29,
          "screenshot_id": "011-verified-pins-visible-without-labels",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 94.91,
          "end": 98.969,
          "text": "A community paramedicine team could use fixed framing for an outreach area,",
          "cue": 30,
          "screenshot_id": "011-verified-pins-visible-without-labels",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 99.299,
          "end": 103.01,
          "text": "while a security team could keep the view centered on the sites it monitors.",
          "cue": 31,
          "screenshot_id": "011-verified-pins-visible-without-labels",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 103.43,
          "end": 107.119,
          "text": "Check the actual board from its viewing distance after making changes.",
          "cue": 32,
          "screenshot_id": "011-verified-pins-visible-without-labels",
          "required_labels": [],
          "instructional": false
        }
      ],
      "visual_required_labels": [
        "Zoom Level: 12"
      ],
