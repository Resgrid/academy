 @section Styles {
     <link rel="stylesheet" href="~/css/module-workspace.css" asp-append-version="true" />
+    <style>
+        /* Fixed columns keep every input usable; Subject and Notes share whatever width is left. INSPINIA's roomy
+           cell and input padding would cut off a select's text in these narrow columns, so the grid is tighter. */
+        #entries { table-layout: fixed; min-width: 1050px; }
+        #entries > thead > tr > th, #entries > tbody > tr > td { padding: 6px 4px; }
+        #entries .form-control { padding: 4px 6px; }
+        /* INSPINIA floats ibox-title labels to the left, which put the status badge in front of the report number. */
+        #dtrForm .ibox-title h5 .label { float: none; margin-left: 4px; vertical-align: middle; }
+    </style>
 }
