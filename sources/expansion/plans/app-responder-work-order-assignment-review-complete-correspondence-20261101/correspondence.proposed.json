        "Inspection": "Inspection"
      },
      "instructional": true
    },
    {
      "start": 18.27,
      "end": 20.45,
      "text": "Firehouse fifty-one as its station.",
      "cue": 5,
      "scene_id": "01",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [
        "Station: Firehouse 51"
      ],
      "spoken_references": {
        "Station: Firehouse 51": "Firehouse fifty-one"
      },
      "instructional": true
    },
    {
      "start": 20.879,
      "end": 23.85,
      "text": "The description makes it a fictional software exercise.",
      "cue": 6,
      "scene_id": "01",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [],
      "spoken_references": {},
      "instructional": false
    },
    {
      "start": 24.329,
      "end": 27.409,
      "text": "Read the Steps section before accepting responsibility",
      "cue": 7,
      "scene_id": "01",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [
        "Steps"
