      "end": 28.819,
      "text": "for the intended assignment.",
      "cue": 8,
      "scene_id": "01",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [],
      "spoken_references": {},
      "instructional": false
    },
    {
      "start": 28.989,
      "end": 32.059,
      "text": "Accept assignment is the green action below Steps.",
      "cue": 9,
      "scene_id": "02",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [
        "Accept assignment",
        "Steps"
      ],
      "spoken_references": {
