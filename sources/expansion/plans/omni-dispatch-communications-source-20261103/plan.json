          "screenshot_id": "001-contact-directory",
          "required_labels": [
            "Contacts"
          ],
          "instructional": true,
          "spoken_references": {
            "Contacts": "Contacts"
          }
        },
        {
          "start": 3.9,
          "end": 8.479,
          "text": "Use the directory filter to narrow the list and open Academy Logistics Desk.",
          "cue": 2,
          "screenshot_id": "001-contact-directory",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 8.89,
          "end": 12.14,
          "text": "Contact Information shows the saved email and office phone.",
          "cue": 3,
          "screenshot_id": "002-contact-detail",
          "required_labels": [
            "Contact Information"
          ],
          "instructional": true,
          "spoken_references": {
            "Contact Information": "Contact Information"
          }
        },
        {
          "start": 12.609,
          "end": 16.84,
          "text": "Location Information shows the coordinates this department recorded for the partner.",
          "cue": 4,
          "screenshot_id": "002-contact-detail",
          "required_labels": [
            "Location Information"
          ],
          "instructional": true,
          "spoken_references": {
            "Location Information": "Location Information"
          }
        },
        {
          "start": 17.27,
          "end": 20.309,
          "text": "A search and rescue dispatcher could use the same directory to",
          "cue": 5,
          "screenshot_id": "002-contact-detail",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 20.309,
          "end": 21.86,
          "text": "look up an equipment coordinator.",
          "cue": 6,
          "screenshot_id": "002-contact-detail",
          "required_labels": [],
          "instructional": false
        }
      ],
