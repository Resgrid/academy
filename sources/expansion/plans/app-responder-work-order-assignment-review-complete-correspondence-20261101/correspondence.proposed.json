  "cues": [
    {
      "start": 0.029,
      "end": 3.1189999999999998,
      "text": "Work orders keep an assignment and its updates together.",
      "cue": 1,
      "scene_id": "01",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [
        "Work orders"
      ],
      "spoken_references": {
        "Work orders": "Work orders"
      },
      "instructional": true
    },
    {
      "start": 3.589,
      "end": 8.818999999999999,
      "text": "Start by reading the intended order, its status, priority, station and due date.",
      "cue": 2,
      "scene_id": "01",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [],
      "spoken_references": {},
      "instructional": false
    },
    {
      "start": 9.27,
      "end": 13.38,
      "text": "This recorded example is Training Only, Assigned software practice.",
      "cue": 3,
      "scene_id": "01",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [
        "TRAINING ONLY — Assigned software practice"
      ],
      "spoken_references": {
        "TRAINING ONLY — Assigned software practice": "Training Only, Assigned software practice"
      },
      "instructional": true
    },
    {
      "start": 13.68,
      "end": 18.27,
      "text": "It is Assigned, has Normal priority, uses the Inspection type and names",
      "cue": 4,
      "scene_id": "01",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [
        "WO-2099-000001 · Assigned · Normal",
