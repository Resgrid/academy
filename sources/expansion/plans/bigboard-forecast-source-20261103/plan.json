      "captions": [
        {
          "start": 90.889,
          "end": 94.73,
          "text": "A community paramedicine team could center a board on its outreach area;",
          "cue": 29,
          "screenshot_id": "005-metric-chicago-forecast",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 95.079,
          "end": 98.609,
          "text": "a wildland contractor could center one on its base of operations.",
          "cue": 30,
          "screenshot_id": "005-metric-chicago-forecast",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 99.149,
          "end": 103.45,
          "text": "Use the separate Weather Alerts widget to review alert headlines and instructions.",
          "cue": 31,
