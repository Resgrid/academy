      "captions": [
        {
          "start": 55.549,
          "end": 59.659,
          "text": "Open Assistant from the menu to reach the prompt field or start a new session.",
          "cue": 17,
          "screenshot_id": "006-assistant-entry",
          "required_labels": [
            "Assistant"
          ],
          "instructional": true,
          "spoken_references": {
            "Assistant": "Assistant"
          }
        },
        {
          "start": 60.27,
          "end": 64.419,
          "text": "This screen shows where a department with Assistant configured can enter a question.",
          "cue": 18,
          "screenshot_id": "006-assistant-entry",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 64.719,
          "end": 69.12,
          "text": "For example, an industrial response coordinator could ask for help organizing",
          "cue": 19,
          "screenshot_id": "006-assistant-entry",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 69.15,
          "end": 71.049,
          "text": "a fictional exercise checklist.",
          "cue": 20,
          "screenshot_id": "006-assistant-entry",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 71.37,
          "end": 72.95,
          "text": "We leave the prompt blank here.",
          "cue": 21,
          "screenshot_id": "006-assistant-entry",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 73.19,
          "end": 76.639,
          "text": "In Settings, look under Preferences for Navigation App.",
          "cue": 22,
          "screenshot_id": "007-device-settings",
          "required_labels": [
            "Navigation App"
          ],
          "instructional": true,
          "spoken_references": {
            "Navigation App": "Navigation App"
          }
        },
        {
          "start": 77.04,
          "end": 81.79,
          "text": "The selector shows Device default, Google Maps and Waze on this workstation.",
          "cue": 23,
          "screenshot_id": "008-navigation-app-options",
          "required_labels": [
            "Google Maps"
          ],
          "instructional": true,
          "spoken_references": {
            "Google Maps": "Google Maps"
          }
        },
        {
          "start": 82.13,
          "end": 85.18,
          "text": "The choice controls what opens when you start navigation from",
          "cue": 24,
          "screenshot_id": "008-navigation-app-options",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 85.18,
          "end": 87.409,
          "text": "a call, destination or map pin.",
          "cue": 25,
          "screenshot_id": "008-navigation-app-options",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 87.769,
          "end": 91.329,
          "text": "Review the choice before a shift where your team relies on those links.",
