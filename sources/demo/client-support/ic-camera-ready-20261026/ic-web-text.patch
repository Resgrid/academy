+/** Web compatibility for the native Camera ref. No coordinates are manufactured here. */
+export interface WebImperativeCameraSettings {
+  centerCoordinate?: [number, number];
+  zoomLevel?: number;
+  heading?: number;
+  pitch?: number;
+  animationDuration?: number;
+}
+
+type CameraCommand = { method: 'easeTo' | 'flyTo'; options: Record<string, unknown> } | {
+  method: 'fitBounds'; bounds: [[number, number], [number, number]]; options: Record<string, unknown>;
+};
+const coordinate = (value: unknown): value is [number, number] => Array.isArray(value) && value.length === 2 && value.every(Number.isFinite);
+const numeric = (value: unknown): value is number => typeof value === 'number' && Number.isFinite(value);
+
+/** Retain the latest native camera request while its web map/style is not ready. */
+export function createWebCameraBridge() {
+  let map: any = null;
+  let pending: CameraCommand | null = null;
+  function apply(command: CameraCommand) {
+    if (!map || map.__removed) {
+      pending = command;
+      return;
+    }
+    if (command.method === 'fitBounds') map.fitBounds(command.bounds, command.options, { _programmatic: true });
+    else map[command.method](command.options, { _programmatic: true });
+  }
+  return {
+    setMap(next: any) {
+      map = next;
+      if (map && !map.__removed && pending) {
+        const command = pending;
+        pending = null;
+        apply(command);
+      }
+    },
+    setCamera(settings: WebImperativeCameraSettings) {
+      if (settings.centerCoordinate !== undefined && !coordinate(settings.centerCoordinate)) return;
+      if ([settings.zoomLevel, settings.heading, settings.pitch, settings.animationDuration].some(value => value !== undefined && !numeric(value))) return;
+      const options: Record<string, unknown> = { duration: settings.animationDuration ?? 1000 };
+      if (settings.centerCoordinate !== undefined) options.center = settings.centerCoordinate;
+      if (settings.zoomLevel !== undefined) options.zoom = settings.zoomLevel;
+      if (settings.heading !== undefined) options.bearing = settings.heading;
+      if (settings.pitch !== undefined) options.pitch = settings.pitch;
+      apply({ method: 'easeTo', options });
+    },
+    flyTo(coordinatesOrOptions: unknown, duration?: number) {
+      if (Array.isArray(coordinatesOrOptions)) {
+        if (!coordinate(coordinatesOrOptions) || (duration !== undefined && !numeric(duration))) return;
+        apply({ method: 'flyTo', options: { center: coordinatesOrOptions, duration: duration ?? 1000 } });
+      } else if (coordinatesOrOptions && typeof coordinatesOrOptions === 'object') {
+        const options = Object.fromEntries(Object.entries(coordinatesOrOptions).filter(([, value]) => value !== undefined));
+        if (options.center !== undefined && !coordinate(options.center)) return;
+        if (['zoom', 'bearing', 'pitch', 'duration'].some(key => options[key] !== undefined && !numeric(options[key]))) return;
+        apply({ method: 'flyTo', options });
+      }
+    },
+    fitBounds(ne: [number, number], sw: [number, number], pad?: number | number[], duration?: number) {
+      if (!coordinate(ne) || !coordinate(sw) || (duration !== undefined && !numeric(duration))) return;
+      if (pad !== undefined && !(numeric(pad) || (Array.isArray(pad) && pad.every(numeric)))) return;
+      const padding = Array.isArray(pad)
+        ? { top: pad[0] ?? 60, right: pad[1] ?? 60, bottom: pad[2] ?? 60, left: pad[3] ?? 60 }
+        : { top: pad ?? 60, right: pad ?? 60, bottom: pad ?? 60, left: pad ?? 60 };
+      apply({ method: 'fitBounds', bounds: [sw, ne], options: { padding, duration: duration ?? 1000 } });
+    },
+  };
+}
+
+/** Report the real map transform using the center/zoom fields consumed by native screens. */
+export function readWebCameraChange(map: any, isUserInteraction: boolean) {
+  const center = map.getCenter();
+  const zoom = map.getZoom();
+  if (!numeric(center?.lng) || !numeric(center?.lat) || !numeric(zoom)) return undefined;
+  return { properties: { isUserInteraction, center: [center.lng, center.lat] as [number, number], zoom } };
+}
