          }
        },
        {
          "start": 3.529,
          "end": 6.889,
          "text": "Use the layers button in the lower left to choose what appears.",
          "cue": 2,
          "screenshot_id": "001-map-overview",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 7.329,
          "end": 11.75,
          "text": "Calls, Units, Stations and Points of interest are separate switches.",
          "cue": 3,
          "screenshot_id": "002-map-layer-switches",
          "required_labels": [
            "Points of interest"
          ],
          "instructional": true,
          "spoken_references": {
            "Points of interest": "Points of interest"
          }
        },
        {
          "start": 12.14,
          "end": 14.069,
          "text": "Department layers are listed below them.",
          "cue": 4,
          "screenshot_id": "002-map-layer-switches",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 14.64,
          "end": 17.48,
          "text": "Turn off Points of interest to reduce clutter,",
          "cue": 5,
          "screenshot_id": "003-filtered-map-layers",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 17.48,
          "end": 18.329,
          "text": "then turn it back",
          "cue": 6,
          "screenshot_id": "002-map-layer-switches",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 18.329,
          "end": 20.45,
          "text": "on before looking for a saved site.",
          "cue": 7,
          "screenshot_id": "002-map-layer-switches",
