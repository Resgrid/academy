+/** Isolated recording compatibility for the installed SDK's limited web build.
+ * Uses real Mapbox GL, source styles/children/markers, and source camera inputs.
+ * It never requests device location, draws substitute maps, or simulates a load.
+ */
+import 'mapbox-gl/dist/mapbox-gl.css';
+
+import OriginalMapbox, { Logger, MarkerView } from '@rnmapbox/maps/src/web';
+import OriginalCamera from '@rnmapbox/maps/src/web/components/Camera';
+import MapContext from '@rnmapbox/maps/src/web/MapContext';
+import mapboxgl from 'mapbox-gl';
+import React, { forwardRef, useContext, useEffect, useImperativeHandle, useRef, useState } from 'react';
+import { StyleSheet } from 'react-native';
+
+import { useDepartmentMapCenter } from '@/lib/map-center';
+import { useLocationStore } from '@/stores/app/location-store';
+
+import { bindWebMapEvents, findWebCameraDeclaration, initialWebMapOptions, resolveWebCameraSettings, type WebCameraDeclaration } from './mapbox-web-compat';
+
+interface CameraProps extends WebCameraDeclaration {
+  animationDuration?: number;
+  animationMode?: string;
+  minZoomLevel?: number;
+  maxZoomLevel?: number;
+}
+
+export const Camera = forwardRef<any, CameraProps>((props, ref) => {
+  const original = useRef<any>(null);
+  const { map } = useContext(MapContext);
+  // Only an already-existing source-app fix can drive follow mode. No permission
+  // prompt, browser geolocation call, or new location source is introduced.
+  const latitude = useLocationStore((state) => state.latitude);
+  const longitude = useLocationStore((state) => state.longitude);
+  const settings = resolveWebCameraSettings(props, { latitude, longitude });
+  useImperativeHandle(ref, () => original.current, [map]);
+  useEffect(() => {
+    if (!map || !original.current) return;
+    original.current.setCamera({ ...settings, animationDuration: props.animationDuration ?? 0, animationMode: props.animationMode ?? 'moveTo' });
+  }, [map, settings.centerCoordinate?.[0], settings.centerCoordinate?.[1], settings.zoomLevel, settings.heading, settings.pitch, props.animationDuration, props.animationMode]);
+  return <OriginalCamera ref={original} {...props} {...settings} />;
+});
+Camera.displayName = 'RecordingWebCamera';
+
+interface MapViewProps {
+  styleURL?: string;
+  style?: any;
+  children?: React.ReactNode;
+  testID?: string;
+  onDidFinishLoadingMap?: (event: any) => void;
+  onCameraChanged?: (event: any) => void;
+  onMapIdle?: (event: any) => void;
+  onMapLoadingError?: (event: any) => void;
+  onPress?: (event: any) => void;
+  scrollEnabled?: boolean;
+  zoomEnabled?: boolean;
+  rotateEnabled?: boolean;
+  pitchEnabled?: boolean;
+}
+
+export const MapView = forwardRef<any, MapViewProps>((props, ref) => {
+  const container = useRef<HTMLDivElement>(null);
+  const latest = useRef(props);
+  latest.current = props;
+  const [map, setMap] = useState<mapboxgl.Map>();
+  const department = useDepartmentMapCenter();
+  const latestDepartment = useRef(department);
+  latestDepartment.current = department;
+  const declaration = findWebCameraDeclaration(props.children, Camera);
+  const declared = resolveWebCameraSettings(declaration ?? {});
+  const userMoved = useRef(false);
+  useImperativeHandle(ref, () => map, [map]);
+
+  useEffect(() => {
+    if (!container.current) return;
+    const currentCamera = resolveWebCameraSettings(findWebCameraDeclaration(latest.current.children, Camera) ?? {});
+    const instance = new mapboxgl.Map({ container: container.current, pitchWithRotate: latest.current.pitchEnabled !== false,
+      ...initialWebMapOptions(latest.current.styleURL || OriginalMapbox.StyleURL.Street, currentCamera, latestDepartment.current) });
+    userMoved.current = false;
+    const detach = bindWebMapEvents(instance, () => latest.current);
+    const onMove = (event: any) => { if (event.originalEvent) userMoved.current = true; };
+    instance.on('movestart', onMove);
+    const resize = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(() => instance.resize());
+    resize?.observe(container.current);
+    setMap(instance);
+    return () => { resize?.disconnect(); detach(); instance.off('movestart', onMove); instance.remove(); };
+  }, [props.styleURL]);
+
+  useEffect(() => {
+    if (map && !declared.centerCoordinate && !userMoved.current) {
+      map.jumpTo({ center: [department.longitude, department.latitude], zoom: declared.zoomLevel ?? department.zoomLevel });
+    }
+  }, [map, declared.centerCoordinate?.[0], declared.centerCoordinate?.[1], declared.zoomLevel, department.longitude, department.latitude, department.zoomLevel]);
+
+  useEffect(() => {
+    if (!map) return;
+    const toggle = (handler: any, enabled: boolean) => enabled ? handler.enable() : handler.disable();
+    toggle(map.dragPan, props.scrollEnabled !== false);
+    toggle(map.scrollZoom, props.zoomEnabled !== false);
+    toggle(map.doubleClickZoom, props.zoomEnabled !== false);
+    toggle(map.boxZoom, props.zoomEnabled !== false);
+    toggle(map.touchZoomRotate, props.zoomEnabled !== false);
+    if (props.rotateEnabled === false) map.touchZoomRotate.disableRotation();
+    else map.touchZoomRotate.enableRotation();
+    toggle(map.dragRotate, props.rotateEnabled !== false);
+    toggle(map.touchPitch, props.pitchEnabled !== false);
+  }, [map, props.scrollEnabled, props.zoomEnabled, props.rotateEnabled, props.pitchEnabled]);
+
+  return <div ref={container} data-testid={props.testID} style={{ width: '100%', height: '100%', position: 'relative', ...StyleSheet.flatten(props.style) }}>
+    {map ? <MapContext.Provider value={{ map }}>{props.children}</MapContext.Provider> : null}
+  </div>;
+});
+MapView.displayName = 'RecordingWebMapView';
+
+export { Logger, MarkerView };
+export * from '@rnmapbox/maps/src/web/MapboxModule';
+export default { ...OriginalMapbox, MapView, Camera };
