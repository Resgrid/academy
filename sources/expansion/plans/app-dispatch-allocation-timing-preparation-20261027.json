{
  "kind": "offline_untimed_recipe_preparation",
  "lesson_id": "app-dispatch-allocation",
  "lesson_sha256": "a9f03e25388af4aa7387685368ba5db686239416a9daf4836165cbf62244b2f7",
  "scene_count": 8,
  "spoken_words": 812,
  "retained_source_images": 22,
  "sequence_source_images": 21,
  "retained_but_not_planned_images": [
    "dispatch-20-own-call-created-console"
  ],
  "span_count": 29,
  "timings_assigned": false,
  "ordered_scene_spans": [
    {
      "id": "app-dispatch-allocation-scene-01",
      "title": "Prepare the incident location and matching fields",
      "required_labels": [
        "New Call",
        "Name",
        "Nature",
        "Priority",
        "Urgent",
        "Type",
        "Structure Fire",
        "Latitude",
        "Longitude"
      ],
      "ordered_spans": [
        {
          "id": "app-dispatch-allocation-scene-01-span-01",
          "speech": "Begin in New Call with a clearly named training exercise. Complete Name and Nature, then choose the department’s Priority and Type. Here, Urgent and Structure Fire match the prepared Academy Training Alarm. A run card is configured beforehand in Core administration; the dispatch app uses that configuration.",
          "first_word": 0,
          "word_count": 47,
          "screenshot_id": "dispatch-03-new-call-matching-fields",
          "sha256": "ea816910b80044cc20a2659a2ca7c236bc34e47ec6096725020b7d7594274de3"
        },
        {
          "id": "app-dispatch-allocation-scene-01-span-02",
          "speech": "Enter and check the incident’s Latitude and Longitude before comparing resources. These are fictional incident coordinates, not a device location. The first exercise stays unsent while we inspect its recommendation. This browser recording cannot establish native background GPS collection or delivery of an alert to a real device.",
          "first_word": 47,
          "word_count": 48,
          "screenshot_id": "dispatch-16-restored-near-call-location",
          "sha256": "b40b286629a8290f0c430adedb27ecef30fea89d52834af1c697c709eca3d841"
        }
      ]
    },
    {
      "id": "app-dispatch-allocation-scene-02",
      "title": "Read a conditional result and its shortfall",
      "required_labels": [
        "Dispatch To",
        "Academy Training Alarm",
        "Decision",
        "Advice",
        "Engine within eight minutes",
        "Yes",
        "Ideal configuration not available",
        "Could not fill"
      ],
      "ordered_spans": [
        {
          "id": "app-dispatch-allocation-scene-02-span-01",
          "speech": "Under Dispatch To, read the named card and its Decision. The rule asks whether an engine is within eight minutes. The first preview says Yes: Engine 51 has an estimated two-minute response. That does not mean the entire response package is complete.",
          "first_word": 0,
          "word_count": 42,
          "screenshot_id": "dispatch-05-conditional-yes-officer-shortfall",
          "sha256": "012bea2a0fed12a1f290beb507fbf7284531602759d00a2742b7cadefda500df"
        },
        {
          "id": "app-dispatch-allocation-scene-02-span-02",
          "speech": "Ideal configuration not available and Could not fill explain that the incident-officer positions are too old. Read the explanation before accepting a proposal. An available vehicle and an eligible officer are separate requirements. The advice to send the initial response is guidance from this configured card; it is not proof that resources have already been dispatched.",
          "first_word": 42,
          "word_count": 56,
          "screenshot_id": "dispatch-06-stale-position-apply-controls",
          "sha256": "f53064de12aa7d8a4d04b7c520c1497e15c860b4b49a85480f7200aed96b2a80"
        }
      ]
    },
    {
      "id": "app-dispatch-allocation-scene-03",
      "title": "Review and apply the complete proposal",
      "required_labels": [
        "Recommended units (1)",
        "Engine 51",
        "Recommended personnel (1)",
        "Christopher Herrmann",
        "Fills: Engine",
        "Fills: Incident officer",
        "Apply recommendation",
        "2 selected"
      ],
      "ordered_spans": [
        {
          "id": "app-dispatch-allocation-scene-03-span-01",
          "speech": "For the next preview, the three unchanged fictional officers received fresh simulated station fixes through the controlled training setup. Their statuses and earlier history were preserved; no device GPS was used.",
          "first_word": 0,
          "word_count": 31,
          "screenshot_id": "dispatch-17-restored-near-complete-decision",
          "sha256": "60998dfae3508b33f0df1c42707a66814bd2ff45610aca9db7e354731fc22d22"
        },
        {
          "id": "app-dispatch-allocation-scene-03-span-02",
          "speech": "The refreshed proposal now lists Engine 51 under Recommended units and Christopher Herrmann under Recommended personnel. The Fills labels explain which package requirement each resource satisfies. Read both rows and their reasons, then choose Apply recommendation.",
          "first_word": 31,
          "word_count": 36,
          "screenshot_id": "dispatch-07-complete-recommendation-resources",
          "sha256": "a2457c7ff1288c047dcb3459372241532231155d961687eeecd1fb21ceb7ca7a"
        },
        {
          "id": "app-dispatch-allocation-scene-03-span-03",
          "speech": "The form changes to two selected. Applying the proposal prepares a selection; it does not create the call.",
          "first_word": 67,
          "word_count": 18,
          "screenshot_id": "dispatch-08-recommendation-applied-unsent",
          "sha256": "6a3ad76d2464059ca5968632538735bde97ce39397d5d084805800b68c859a6a"
        },
        {
          "id": "app-dispatch-allocation-scene-03-span-04",
          "speech": "Open that selection to inspect the actual people and units before proceeding.",
          "first_word": 85,
          "word_count": 12,
          "screenshot_id": "dispatch-09-closest-personnel-near",
          "sha256": "4ee58d2bbe7bbef1d3d96a30ec68648767aeade8cce4a7a91248d1bb9dfc7c04"
        }
      ]
    },
    {
      "id": "app-dispatch-allocation-scene-04",
      "title": "Compare closest people, names and availability",
      "required_labels": [
        "Select Dispatch Recipients",
        "Closest",
        "Name",
        "Available only",
        "Everyone",
        "No location",
        "Confirm"
      ],
      "ordered_spans": [
        {
          "id": "app-dispatch-allocation-scene-04-span-01",
          "speech": "The Select Dispatch Recipients sheet offers Closest, Name and Available only. Closest follows the server’s location-aware board. Herrmann appears with Nearest number one and the Run card badge.",
          "first_word": 0,
          "word_count": 28,
          "screenshot_id": "dispatch-09-closest-personnel-near",
          "sha256": "4ee58d2bbe7bbef1d3d96a30ec68648767aeade8cce4a7a91248d1bb9dfc7c04"
        },
        {
          "id": "app-dispatch-allocation-scene-04-span-02",
          "speech": "Name changes the order; Blake Gallo then appears with Unavailable and No location. The absence of a location is useful information, not an invitation to guess one.",
          "first_word": 28,
          "word_count": 27,
          "screenshot_id": "dispatch-10-name-sort-unavailable-location",
          "sha256": "79867b9c1194d7b8f7fc86e71a0368c358d8b5949274721a790e746c9b067195"
        },
        {
          "id": "app-dispatch-allocation-scene-04-span-03",
          "speech": "Available only reduces this example from fourteen users to twelve. Previously selected recipients remain selected, so review the checkmarks and total as well as the filter.",
          "first_word": 55,
          "word_count": 26,
          "screenshot_id": "dispatch-11-available-only-personnel",
          "sha256": "beac0945dec27b2cf63b5c7581c0a3c6cf305b27b72af827a22bf949258c29ff"
        },
        {
          "id": "app-dispatch-allocation-scene-04-span-04",
          "speech": "Everyone is a broader recipient choice. Leave it clear when this exercise needs only named resources.",
          "first_word": 81,
          "word_count": 16,
          "screenshot_id": "dispatch-09-closest-personnel-near",
          "sha256": "4ee58d2bbe7bbef1d3d96a30ec68648767aeade8cce4a7a91248d1bb9dfc7c04"
        }
      ]
    },
    {
      "id": "app-dispatch-allocation-scene-05",
      "title": "Choose the unit and distinguish its group",
      "required_labels": [
        "Select Dispatch Recipients",
        "Engine 51",
        "Nearest #3",
        "Run card",
        "Crew: Christopher Herrmann (Officer / Team Lead)",
        "At station",
        "2 selected",
        "Confirm"
      ],
      "ordered_spans": [
        {
          "id": "app-dispatch-allocation-scene-05-span-01",
          "speech": "Search for Engine to narrow the sheet. The Groups entry called Engine 51 and the unit called Engine 51 are separate choices. In this example the group is unchecked and the unit is checked. Read the unit’s Available status, Herrmann’s crew assignment and At station position source. Its Nearest number three badge is its place among the board’s available units; it does not say that three engines are selected. The row shows an estimated travel time, while the board can rank units using turnout plus travel. Confirm returns the selected recipients to the call form. It is still separate from creating or dispatching the call.",
          "first_word": 0,
          "word_count": 105,
          "screenshot_id": "dispatch-12-closest-unit-station-crew",
          "sha256": "7b96c0953e30d120c3c20dc0f292ebd0d25bac7aa58338c73a76593f32cf7005"
        }
      ]
    },
    {
      "id": "app-dispatch-allocation-scene-06",
      "title": "Compare a distant incident and return to the near point",
      "required_labels": [
        "Decision",
        "Outcome: Review alternatives",
        "Advice",
        "No",
        "Christopher Herrmann",
        "Engine 51",
        "At station",
        "Latitude",
        "Longitude"
      ],
      "ordered_spans": [
        {
          "id": "app-dispatch-allocation-scene-06-span-01",
          "speech": "Changing only the unsent incident’s coordinates creates the distant comparison. The same engine now fails the eight-minute condition, and the outcome becomes Review alternatives. The advice-only branch recommends no additional package.",
          "first_word": 0,
          "word_count": 31,
          "screenshot_id": "dispatch-13-far-condition-advice",
          "sha256": "b76f45854cf3928f01499af569fcf29ebe7331efeae89a2b4c5514ae6e03d2d1"
        },
        {
          "id": "app-dispatch-allocation-scene-06-span-02",
          "speech": "The recipient sheet shows about one hundred and one kilometres and roughly one hundred and ninety-eight minutes for both Herrmann and Engine 51.",
          "first_word": 31,
          "word_count": 23,
          "screenshot_id": "dispatch-14-far-personnel-comparison",
          "sha256": "ea58f19d5f290c34f4d240f2664e0dbc424d6ab9bb70311ff7dde74c75a0d797"
        },
        {
          "id": "app-dispatch-allocation-scene-06-span-03",
          "speech": "The run-card response estimate is slightly longer because its response calculation includes turnout. These are estimates, not a promise of arrival.",
          "first_word": 54,
          "word_count": 21,
          "screenshot_id": "dispatch-15-far-unit-comparison",
          "sha256": "77fbee1d44626915de32a499fd3e4c7ba780ccf8395f6233472bda5a9e9f7c0a"
        },
        {
          "id": "app-dispatch-allocation-scene-06-span-04",
          "speech": "Notice that the earlier two selected recipients remain in the form even when the recommendation changes.",
          "first_word": 75,
          "word_count": 16,
          "screenshot_id": "dispatch-13-far-condition-advice",
          "sha256": "b76f45854cf3928f01499af569fcf29ebe7331efeae89a2b4c5514ae6e03d2d1"
        },
        {
          "id": "app-dispatch-allocation-scene-06-span-05",
          "speech": "Restore the near coordinates",
          "first_word": 91,
          "word_count": 4,
          "screenshot_id": "dispatch-16-restored-near-call-location",
          "sha256": "b40b286629a8290f0c430adedb27ecef30fea89d52834af1c697c709eca3d841"
        },
        {
          "id": "app-dispatch-allocation-scene-06-span-06",
          "speech": "and review both the new decision and your selection.",
          "first_word": 95,
          "word_count": 9,
          "screenshot_id": "dispatch-17-restored-near-complete-decision",
          "sha256": "60998dfae3508b33f0df1c42707a66814bd2ff45610aca9db7e354731fc22d22"
        }
      ]
    },
    {
      "id": "app-dispatch-allocation-scene-07",
      "title": "Save a controlled training allocation and inspect its pin",
      "required_labels": [
        "Dispatched",
        "Strike alarm 2",
        "Dispatch additional resources",
        "Christopher Herrmann",
        "Engine 51",
        "Select Dispatch Recipients",
        "Decision",
        "Re-evaluate"
      ],
      "ordered_spans": [
        {
          "id": "app-dispatch-allocation-scene-07-span-01",
          "speech": "For the saved example, a separate call named TRAINING ONLY, Dispatch allocation recording was created with those same two fictional recipients after checking every field. Open Dispatched to inspect what the application stored: Herrmann as a user and Engine 51 as a unit.",
          "first_word": 0,
          "word_count": 43,
          "screenshot_id": "dispatch-21-own-saved-dispatched-controls",
          "sha256": "8aaf90857babf6807192f12b72321a2bb62885ea92ea8ce4312ffdac36740d13"
        },
        {
          "id": "app-dispatch-allocation-scene-07-span-02",
          "speech": "Dispatch additional resources opens the existing call’s recommendation. Its banner says the decision was pinned from the dispatcher’s preview, and the explanation counts the engine and officer already on the call. Zero additional recommendations can mean the existing allocation covers the package.",
          "first_word": 43,
          "word_count": 42,
          "screenshot_id": "dispatch-22-own-saved-pinned-decision",
          "sha256": "9a83ae69dc747dbd9dd93731d71dcd10bdc011b3553c393a4e8bd451ce9c87eb"
        },
        {
          "id": "app-dispatch-allocation-scene-07-span-03",
          "speech": "Strike alarm two is visible, but this training card has only one configured level, so no escalation is exercised here.",
          "first_word": 85,
          "word_count": 20,
          "screenshot_id": "dispatch-21-own-saved-dispatched-controls",
          "sha256": "8aaf90857babf6807192f12b72321a2bb62885ea92ea8ce4312ffdac36740d13"
        }
      ]
    },
    {
      "id": "app-dispatch-allocation-scene-08",
      "title": "Re-evaluate deliberately and finish the exercise",
      "required_labels": [
        "Re-evaluate",
        "Outcome: Review alternatives",
        "No",
        "0 selected",
        "Close Call",
        "Close Type",
        "Close Note",
        "Notify everyone on the call",
        "Active Calls",
        "Released",
        "Awaiting Resources",
        "No calls awaiting resources"
      ],
      "ordered_spans": [
        {
          "id": "app-dispatch-allocation-scene-08-span-01",
          "speech": "Re-evaluate requests a current calculation.",
          "first_word": 0,
          "word_count": 5,
          "screenshot_id": "dispatch-22-own-saved-pinned-decision",
          "sha256": "9a83ae69dc747dbd9dd93731d71dcd10bdc011b3553c393a4e8bd451ce9c87eb"
        },
        {
          "id": "app-dispatch-allocation-scene-08-span-02",
          "speech": "Here it returns No and Review alternatives after ordinary call creation changed the engine to Responding. Treat this as a fresh assessment, not another dispatch or evidence that the earlier recipients vanished.",
          "first_word": 5,
          "word_count": 32,
          "screenshot_id": "dispatch-23-own-reevaluated-advice",
          "sha256": "ca2a55e5c2078328878824525c54fc9bc036e68bde7e0222e0a37b90312fd23c"
        },
        {
          "id": "app-dispatch-allocation-scene-08-span-03",
          "speech": "Cancel the picker without adding anyone.",
          "first_word": 37,
          "word_count": 6,
          "screenshot_id": "dispatch-23-own-reevaluated-advice",
          "sha256": "ca2a55e5c2078328878824525c54fc9bc036e68bde7e0222e0a37b90312fd23c"
        },
        {
          "id": "app-dispatch-allocation-scene-08-span-04",
          "speech": "To finish this disposable exercise, Close Call uses Closed, a training note, and Notify everyone on the call switched off.",
          "first_word": 43,
          "word_count": 20,
          "screenshot_id": "dispatch-25-own-close-notifications-off",
          "sha256": "be61301d32451b71b8d353bbbf018498b171c17de6765749fa971730442f47ec"
        },
        {
          "id": "app-dispatch-allocation-scene-08-span-05",
          "speech": "Only this new call was closed. The console returned to the original three active calls,",
          "first_word": 63,
          "word_count": 15,
          "screenshot_id": "dispatch-26-own-close-returned-original-three",
          "sha256": "fc8cd89b19fd1c30fd9681eab1a857f70749bd6327181ca3b5cce9f6ce89302e"
        },
        {
          "id": "app-dispatch-allocation-scene-08-span-06",
          "speech": "and Activity records the engine’s normal change from Responding to Released.",
          "first_word": 78,
          "word_count": 11,
          "screenshot_id": "dispatch-28-own-recorded-unit-activity",
          "sha256": "05ac8d31fad262d3f916622d4d911bdc0f9830112387dda7220d2853bb89ad5c"
        },
        {
          "id": "app-dispatch-allocation-scene-08-span-07",
          "speech": "Awaiting Resources is a separate queue for outstanding requirements; the captured queue is empty, so no requirement fulfilment or dismissal is claimed.",
          "first_word": 89,
          "word_count": 22,
          "screenshot_id": "dispatch-18-awaiting-resources-empty",
          "sha256": "8b415178d7bc6dbaa9eff2e4937f7141f79f99ccfe9ecf98fdb3faa205b7e11f"
        }
      ]
    }
  ],
