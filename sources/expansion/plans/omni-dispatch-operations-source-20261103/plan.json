          "screenshot_id": "005-records-workspace",
          "required_labels": [
            "DRAFTS"
          ],
          "instructional": true,
          "spoken_references": {
            "DRAFTS": "Drafts"
          }
        },
        {
          "start": 92.319,
          "end": 96.399,
          "text": "Use the call tab when you need the context of a particular incident, and",
          "cue": 28,
          "screenshot_id": "005-records-workspace",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 96.399,
