  "scenes": [
    {
      "id": "01",
      "title": "Read the board and open map settings",
      "kind": "operational",
      "start": 0.0,
      "end": 34.999,
      "screens": [
        {
          "screenshot_id": "001-map-widget-with-current-markers",
          "start": 0.0,
          "end": 17.83
        },
        {
          "screenshot_id": "002-map-options-and-visibility",
          "start": 17.83,
          "end": 34.999
        }
      ],
      "captions": [
        {
          "start": 0.09,
          "end": 3.319,
          "text": "A Big Board map can give everyone in a room the same view of",
          "cue": 1,
          "screenshot_id": "001-map-widget-with-current-markers",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 3.319,
          "end": 5.699,
          "text": "calls, stations, and resources.",
          "cue": 2,
          "screenshot_id": "001-map-widget-with-current-markers",
          "required_labels": [
            "Map"
          ],
          "instructional": true,
          "spoken_references": {
            "Map": "calls, stations, and resources"
          }
        },
        {
          "start": 6.15,
          "end": 9.55,
          "text": "This training board starts with several kinds of pins and labels.",
          "cue": 3,
          "screenshot_id": "001-map-widget-with-current-markers",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 9.989,
          "end": 13.189,
          "text": "A search and rescue team might use it to watch a staging area.",
          "cue": 4,
          "screenshot_id": "001-map-widget-with-current-markers",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 13.619,
          "end": 17.6,
          "text": "An industrial response team could focus the same widget on its facility.",
          "cue": 5,
          "screenshot_id": "001-map-widget-with-current-markers",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 17.83,
          "end": 19.689,
          "text": "Open Settings and choose Map.",
          "cue": 6,
          "screenshot_id": "002-map-options-and-visibility",
          "required_labels": [
            "Map"
          ],
          "instructional": true,
          "spoken_references": {
            "Map": "Map"
          }
        },
        {
          "start": 20.379,
          "end": 25.529,
          "text": "Under Map Options, Zoom Out to Show All Pins fits the view to the displayed pins.",
          "cue": 7,
          "screenshot_id": "002-map-options-and-visibility",
          "required_labels": [
            "Zoom Out to Show All Pins"
          ],
          "instructional": true,
          "spoken_references": {
            "Zoom Out to Show All Pins": "Zoom Out to Show All Pins"
          }
        },
        {
          "start": 25.97,
          "end": 29.14,
          "text": "The Visible Pins switches control what the widget includes.",
          "cue": 8,
          "screenshot_id": "002-map-options-and-visibility",
          "required_labels": [
            "Visible Pins"
          ],
          "instructional": true,
          "spoken_references": {
            "Visible Pins": "Visible Pins"
          }
        },
        {
          "start": 29.51,
          "end": 33.53,
          "text": "Calls and linked calls have separate switches, so check both when choosing",
          "cue": 9,
          "screenshot_id": "002-map-options-and-visibility",
          "required_labels": [
            "Show Linked Calls"
          ],
          "instructional": true,
          "spoken_references": {
            "Show Linked Calls": "linked calls"
          }
        },
        {
          "start": 33.53,
          "end": 34.819,
          "text": "what the board needs to show.",
          "cue": 10,
          "screenshot_id": "002-map-options-and-visibility",
          "required_labels": [],
          "instructional": false
        }
      ],
      "visual_required_labels": [
        "Map",
        "Zoom Out to Show All Pins",
        "Visible Pins",
        "Show Linked Calls"
      ],
      "instruction_review": {
        "reviewer": "Root",
        "reviewed_at": "2026-11-03T18:58:58.260826+00:00",
        "passed": true,
        "correspondence_reviewed": true,
