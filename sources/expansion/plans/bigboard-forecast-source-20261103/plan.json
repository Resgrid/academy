    {
      "id": "02",
      "title": "Set units and location",
      "kind": "operational",
      "start": 15.469,
      "end": 54.01,
      "screens": [
        {
          "screenshot_id": "002-weather-widget-settings",
          "start": 15.469,
          "end": 33.11
        },
        {
          "screenshot_id": "003-metric-and-chicago-coordinates",
          "start": 33.11,
          "end": 48.819
        },
        {
          "screenshot_id": "002-weather-widget-settings",
          "start": 48.819,
          "end": 54.01
        }
      ],
      "captions": [
        {
          "start": 15.469,
          "end": 17.92,
          "text": "In Configure, open Weather Widget.",
          "cue": 6,
          "screenshot_id": "002-weather-widget-settings",
          "required_labels": [
            "Weather Widget"
          ],
          "instructional": true,
          "spoken_references": {
            "Weather Widget": "Weather Widget"
          }
        },
        {
          "start": 18.289,
          "end": 21.869,
          "text": "The Units choices are Standard, Metric and Imperial.",
          "cue": 7,
          "screenshot_id": "002-weather-widget-settings",
          "required_labels": [
            "Units"
          ],
          "instructional": true,
          "spoken_references": {
            "Units": "Units"
          }
        },
        {
          "start": 22.26,
          "end": 27.62,
          "text": "Standard uses Kelvin, Metric uses Celsius, and Imperial uses Fahrenheit.",
          "cue": 8,
          "screenshot_id": "002-weather-widget-settings",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 27.969,
          "end": 30.79,
          "text": "Pick the units your team expects to read at a glance.",
          "cue": 9,
          "screenshot_id": "002-weather-widget-settings",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 31.16,
          "end": 32.87,
          "text": "This board starts in Imperial.",
          "cue": 10,
          "screenshot_id": "002-weather-widget-settings",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 33.11,
          "end": 34.29,
          "text": "Select Metric.",
          "cue": 11,
          "screenshot_id": "003-metric-and-chicago-coordinates",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 34.709,
          "end": 38.36,
          "text": "The latitude and longitude fields choose the location for this widget.",
          "cue": 12,
          "screenshot_id": "003-metric-and-chicago-coordinates",
          "required_labels": [
            "Latitude"
          ],
          "instructional": true,
          "spoken_references": {
            "Latitude": "latitude"
          }
        },
        {
          "start": 38.86,
          "end": 43.17,
          "text": "Here we enter forty-one point eight five north and negative eighty-seven",
          "cue": 13,
          "screenshot_id": "003-metric-and-chicago-coordinates",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 43.17,
          "end": 45.019,
          "text": "point six nine for longitude.",
          "cue": 14,
          "screenshot_id": "003-metric-and-chicago-coordinates",
          "required_labels": [
            "Longitude"
          ],
          "instructional": true,
          "spoken_references": {
            "Longitude": "longitude"
          }
        },
        {
          "start": 45.449,
          "end": 48.43,
          "text": "Keep the minus sign for a location west of Greenwich.",
          "cue": 15,
          "screenshot_id": "003-metric-and-chicago-coordinates",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 48.819,
          "end": 52.32,
          "text": "Leaving both values at zero lets the app use the department map",
          "cue": 16,
          "screenshot_id": "002-weather-widget-settings",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 52.32,
          "end": 53.759,
          "text": "center when it is available.",
          "cue": 17,
          "screenshot_id": "002-weather-widget-settings",
          "required_labels": [],
          "instructional": false
        }
      ],
      "visual_required_labels": [
        "Weather Widget",
        "Units",
        "Latitude",
        "Longitude"
      ],
