      "captions": [
        {
          "start": 21.84,
          "end": 26.399,
          "text": "In Core, open Mapping and BigBoard Settings from Department Settings.",
          "cue": 8,
          "screenshot_id": "028-operations-menu-mapping-settings-link",
          "required_labels": [
            "Mapping and BigBoard Settings"
          ],
          "instructional": true,
          "spoken_references": {
            "Mapping and BigBoard Settings": "Mapping and BigBoard Settings"
          }
        },
        {
          "start": 26.8,
          "end": 28.769,
          "text": "Find Unit Status Timers.",
          "cue": 9,
          "screenshot_id": "001-staging-timer-thresholds-prepared",
          "required_labels": [
            "Unit Status Timers"
          ],
          "instructional": true,
          "spoken_references": {
            "Unit Status Timers": "Unit Status Timers"
          }
        },
        {
          "start": 29.229,
          "end": 33.94,
          "text": "For the first exercise, Staging warns after one minute and alerts after two.",
          "cue": 10,
          "screenshot_id": "001-staging-timer-thresholds-prepared",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 34.3,
          "end": 36.119,
          "text": "These are short practice thresholds.",
          "cue": 11,
          "screenshot_id": "001-staging-timer-thresholds-prepared",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 36.48,
          "end": 40.38,
          "text": "Enter zero in both boxes for a status you do not want to time.",
          "cue": 12,
          "screenshot_id": "001-staging-timer-thresholds-prepared",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 40.79,
          "end": 44.71,
          "text": "The rows correspond to what a unit status means, so check that meaning",
          "cue": 13,
          "screenshot_id": "001-staging-timer-thresholds-prepared",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 44.71,
          "end": 46.469,
          "text": "when you use custom statuses.",
          "cue": 14,
          "screenshot_id": "001-staging-timer-thresholds-prepared",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 46.589,
          "end": 49.859,
          "text": "This department requires a reason for warnings and alerts.",
          "cue": 15,
          "screenshot_id": "029-required-reason-policy-readback",
          "required_labels": [
            "Reason when acknowledging"
          ],
          "instructional": true,
          "spoken_references": {
            "Reason when acknowledging": "requires a reason"
          }
        },
        {
          "start": 50.26,
          "end": 54.38,
          "text": "That setting controls what you must enter when acknowledging or muting an item.",
          "cue": 16,
          "screenshot_id": "029-required-reason-policy-readback",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 54.81,
          "end": 56.41,
          "text": "It does not change the timer.",
          "cue": 17,
          "screenshot_id": "029-required-reason-policy-readback",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 56.86,
          "end": 60.36,
          "text": "Save the department settings, then reopen the page to check that the",
          "cue": 18,
          "screenshot_id": "002-save-department-settings",
          "required_labels": [
            "Save"
          ],
          "instructional": true,
          "spoken_references": {
            "Save": "Save"
