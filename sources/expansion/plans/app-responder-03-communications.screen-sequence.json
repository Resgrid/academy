  "scenes": [
    {
      "id": "01-choose-the-right-communication-surface",
      "title": "Choose the right communication surface",
      "narration_sha256": "dbcb711543c1e6cbe9001aabfd8d111906e04843b531270207707f4cd950c97b",
      "required_labels": [
        "Inbox",
        "Sent",
        "All Messages",
        "Chat"
      ],
      "spoken_label_references": {},
      "sequence": [
        {
          "order": 1,
          "spoken_text": "Messages organizes departmental notices into Inbox, Sent, and All Messages. ",
          "screenshot_id": "059-message-mailbox-filters",
          "source_sha256": "80e4a4f09af96569335e4b147d5c8aad5fd818bca0b519e2b6004e6d7a4c48c8",
          "required_labels": [
            "Inbox",
            "Sent",
            "All Messages"
          ],
          "visible_control_names": [],
          "purpose": "Show the actual mailbox menu while each mailbox is named."
        },
        {
          "order": 2,
          "spoken_text": "Chat organizes ongoing conversations. Choose the audience and purpose before composing anything. Community response teams can use a notice for a briefing and a chat for coordination; industrial teams can use the same distinction for shift handovers. ",
          "screenshot_id": "077-chat-direct-and-group-list",
          "source_sha256": "100c057c2c7b9c1a063af759e4e0f26ffd9e39fc124537fd9310d946a6af73b0",
          "required_labels": [
            "Chat"
          ],
          "visible_control_names": [],
          "purpose": "Show the conversation list, retaining the training group and direct-message context."
        },
        {
          "order": 3,
          "spoken_text": "A stored message in your own app confirms a record, not delivery to every recipient’s device.",
          "screenshot_id": "064-message-sent-result",
          "source_sha256": "049bf3d8936bb3d6af66f1d957ea8ae6a9fd6c33a1a8eba86223c679943e4d17",
          "required_labels": [
            "Sent"
          ],
          "visible_control_names": [],
          "purpose": "Show the actual saved fictional notice; no device delivery claim."
        }
      ],
      "timing_status": "pending_actual_speech_timed_captions"
    },
    {
      "id": "02-compose-a-scoped-departmental-message",
      "title": "Compose a scoped departmental message",
      "narration_sha256": "ba30653b2e30ac63a1d05316be348528d8aff886828f1a67058a15eef71b60de",
      "required_labels": [
        "Compose",
        "New Message",
        "Message Type",
        "Recipients",
        "Subject",
        "Message Body",
        "Send"
      ],
      "spoken_label_references": {},
      "sequence": [
        {
          "order": 1,
          "spoken_text": "The Compose icon ",
          "screenshot_id": "078-incoming-acknowledgement-inbox",
          "source_sha256": "ffe164eaaad0161a70eb2722e393c3781745b1a39f8ce84905a5ccfd592fbeb9",
          "required_labels": [
            "Compose"
          ],
          "visible_control_names": [
            "Compose"
          ],
          "purpose": "The visible Compose icon is the circular lower-right control."
        },
        {
          "order": 2,
          "spoken_text": "opens New Message. Choose Message Type and Recipients, then enter a clear Subject and Message Body. ",
          "screenshot_id": "060-message-compose",
          "source_sha256": "6fcefdc0126e8d145a65b1bc707b1bdd9fb322724a974c34a34b2481534f4a5b",
          "required_labels": [
            "New Message",
            "Message Type",
            "Recipients",
            "Subject",
            "Message Body"
          ],
          "visible_control_names": [],
          "purpose": "Show the whole compose form when its fields are explained."
        },
        {
          "order": 3,
          "spoken_text": "The recipient picker separates People, Groups, and Roles. ",
          "screenshot_id": "061-message-recipients",
          "source_sha256": "41de878fc89f61559708048bd6cae0256af94cc35c464100da933d25aef4bff1",
          "required_labels": [
            "People",
            "Groups",
            "Roles"
          ],
          "visible_control_names": [],
          "purpose": "Show the actual recipient picker tabs, with no recipients yet selected."
        },
        {
          "order": 4,
          "spoken_text": "Check the selected names before Send. Our training notice goes only to the fictional Boden account. ",
          "screenshot_id": "063-message-training-prepared-confirmed",
          "source_sha256": "e30b004efc8934670198ff98836cad0a776e266f3f387b8d4ffed2c40c78b9e1",
          "required_labels": [
            "Send",
            "Wallace Boden",
            "1 recipients selected"
          ],
          "visible_control_names": [],
          "purpose": "The prepared notice targets only the fictional signed-in account."
        },
        {
          "order": 5,
          "spoken_text": "Find its saved card in Sent and open the content afterward; do not treat that card as proof of a push notification.",
          "screenshot_id": "064-message-sent-result",
          "source_sha256": "049bf3d8936bb3d6af66f1d957ea8ae6a9fd6c33a1a8eba86223c679943e4d17",
          "required_labels": [
            "Sent"
          ],
          "visible_control_names": [],
          "purpose": "The saved list card is visible. Opening a saved notice is an instruction, not a claim that this shot shows the opened record."
        }
      ],
      "timing_status": "pending_actual_speech_timed_captions"
    },
    {
      "id": "03-respond-and-maintain-the-inbox",
      "title": "Respond and maintain the inbox",
      "narration_sha256": "ca2814e7180e804b4db2ced59b73eea529af7a73c6e19b47581bba500f13afa0",
      "required_labels": [
        "Respond to Message",
        "Response",
        "Note (Optional)",
        "Send Response",
        "Responded",
        "Select All",
        "Delete"
      ],
      "spoken_label_references": {},
      "sequence": [
        {
          "order": 1,
          "spoken_text": "An incoming Poll can open Respond to Message through its reply arrow. Enter Response, ",
          "screenshot_id": "132-message-response-heading-complete",
          "source_sha256": "5e79c6fbd8304cf33032a377b1b42b92c70b8b69397e3d9b7d6a21d66fa53240",
          "required_labels": [
            "Respond to Message",
            "Response"
          ],
          "visible_control_names": [],
          "purpose": "Show the response form heading and Yes value for the equipment-readiness poll."
        },
        {
          "order": 2,
          "spoken_text": "add a Note (Optional), ",
          "screenshot_id": "079-message-response-prepared",
          "source_sha256": "f2eebd757e1f3a6d765aa38043d0118f3e1a2753eb75db1977a688d314c90ce8",
          "required_labels": [
            "Note (Optional)"
          ],
          "visible_control_names": [],
          "purpose": "Show the complete Note label and fictional briefing note in the other captured training poll."
        },
        {
          "order": 3,
          "spoken_text": "and choose Send Response. ",
          "screenshot_id": "133-message-response-note-send",
          "source_sha256": "0cc2006cb6ca2cfda13c1629328d0df5ab8e2eff1c4bf312156272b0dc5efc34",
          "required_labels": [
            "Send Response"
          ],
          "visible_control_names": [],
          "purpose": "Show the actual lower form action; do not use its offscreen Note heading as evidence."
        },
        {
          "order": 4,
          "spoken_text": "The training polls show a stored Yes response as code one; inspect the Responded result. ",
          "screenshot_id": "134-readiness-acknowledgement-result",
          "source_sha256": "e2dd9b3f89f45a8d6073eb4c873b06c73f8ea74a4d60bacecba2565c6c50507f",
          "required_labels": [
            "Responded",
            "Response: 1"
          ],
          "visible_control_names": [],
          "purpose": "Show the saved equipment-readiness result. The screenshot records a stored response, not peer delivery."
        },
        {
          "order": 5,
          "spoken_text": "Long-pressing a card exposes Select All and Delete. Review the selection carefully. This browser’s native confirmation does not complete deletion, so these examples preserve both messages.",
          "screenshot_id": "135-message-bulk-selection",
          "source_sha256": "aa9fe0cc04295754a8e1f0f5029bf5f2733e24b1f49d76747ec08c9dd71439f8",
          "required_labels": [
            "Select All",
            "Delete"
          ],
          "visible_control_names": [],
          "purpose": "Show selection actions while the narration states that deletion was not completed."
        }
      ],
      "timing_status": "pending_actual_speech_timed_captions"
    },
    {
