      ],
      "captions": [
        {
          "start": 36.349,
          "end": 40.899,
          "text": "On the Dispatch Console, open the warehouse exercise and select Command.",
          "cue": 13,
          "screenshot_id": "006-incident-command-summary",
          "required_labels": [
            "Command"
          ],
          "instructional": true,
          "spoken_references": {
            "Command": "Command"
          }
        },
        {
          "start": 41.43,
          "end": 44.66,
          "text": "The command summary names the commander and shows the structure.",
          "cue": 14,
          "screenshot_id": "006-incident-command-summary",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 45.099,
          "end": 48.16,
          "text": "In this example, Squad Three is in Search Division.",
          "cue": 15,
          "screenshot_id": "006-incident-command-summary",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 48.679,
          "end": 52.83,
          "text": "Use View Squad Three to see the lane assignment and its requirements warning.",
          "cue": 16,
          "screenshot_id": "007-command-resource-details",
          "required_labels": [
            "Squad 3"
          ],
          "instructional": true,
          "spoken_references": {
            "Squad 3": "Squad Three"
          }
        },
        {
          "start": 53.34,
          "end": 56.949,
          "text": "A search and rescue dispatcher could use the same view to confirm which",
          "cue": 17,
          "screenshot_id": "007-command-resource-details",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 56.949,
          "end": 58.49,
          "text": "group a search team is working with.",
          "cue": 18,
          "screenshot_id": "007-command-resource-details",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 58.85,
          "end": 62.03,
          "text": "Check Accountability to see the current check-in indicators.",
          "cue": 19,
          "screenshot_id": "011-command-accountability",
          "required_labels": [
            "Accountability (PAR)"
          ],
          "instructional": true,
          "spoken_references": {
            "Accountability (PAR)": "Accountability"
          }
        },
        {
          "start": 62.419,
          "end": 65.569,
          "text": "Objectives shows the progress of the assigned benchmark.",
          "cue": 20,
          "screenshot_id": "011-command-accountability",
          "required_labels": [
            "Objectives"
          ],
          "instructional": true,
          "spoken_references": {
            "Objectives": "Objectives"
          }
        },
        {
          "start": 65.919,
          "end": 70.449,
          "text": "The separate Check-In tab shows the timer and last check-in for a tracked entry.",
          "cue": 21,
          "screenshot_id": "010-incident-check-in-status",
          "required_labels": [
            "Check-In"
          ],
          "instructional": true,
          "spoken_references": {
            "Check-In": "Check-In"
          }
        },
        {
          "start": 70.85,
          "end": 73.69,
          "text": "Confirm the entry before using the check-in action.",
          "cue": 22,
          "screenshot_id": "010-incident-check-in-status",
          "required_labels": [],
          "instructional": false
        }
      ],
