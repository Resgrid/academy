  "scenes": [
    {
      "id": "01",
      "title": "Read the existing forecast",
      "kind": "operational",
      "start": 0.0,
      "end": 15.469,
      "screens": [
        {
          "screenshot_id": "001-chicago-current-conditions-imperial",
          "start": 0.0,
          "end": 15.469
        }
      ],
      "captions": [
        {
          "start": 0.07,
          "end": 3.109,
          "text": "The Weather widget gives a shared board a quick read on current",
          "cue": 1,
          "screenshot_id": "001-chicago-current-conditions-imperial",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 3.109,
          "end": 4.71,
          "text": "conditions and the days ahead.",
          "cue": 2,
          "screenshot_id": "001-chicago-current-conditions-imperial",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 5.11,
          "end": 7.369,
          "text": "Here it shows Chicago in Fahrenheit.",
          "cue": 3,
          "screenshot_id": "001-chicago-current-conditions-imperial",
          "required_labels": [
            "Weather - Chicago"
          ],
          "instructional": true,
          "spoken_references": {
            "Weather - Chicago": "Chicago"
          }
        },
        {
          "start": 7.809,
          "end": 11.6,
          "text": "A security supervisor can use the same display for outdoor posts,",
          "cue": 4,
          "screenshot_id": "001-chicago-current-conditions-imperial",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 11.88,
          "end": 15.1,
          "text": "and a search and rescue coordinator can use it for a staging area.",
          "cue": 5,
          "screenshot_id": "001-chicago-current-conditions-imperial",
          "required_labels": [],
          "instructional": false
        }
      ],
      "visual_required_labels": [
        "Weather - Chicago"
      ],
      "instruction_review": {
        "reviewer": "Root",
        "reviewed_at": "2026-11-03T18:58:10.216860+00:00",
