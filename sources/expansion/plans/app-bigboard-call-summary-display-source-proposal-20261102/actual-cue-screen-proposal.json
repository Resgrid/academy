{
  "lesson_id": "app-bigboard-call-summary-display",
  "source_sha256": "356849f353bd1829def2f36ec65fe8032e058a42450febf6390ce67f02fb6113",
  "captures_sha256": "1b7d0a05ccfdaf5c93d28653bf2bd91364f2b603ebe77686b849b08231bc2838",
  "actual_srt_sha256": "c09490769179f7f6932da602b3906cc946bdad13201a3c4db345c836770b9680",
  "caption_cues": [
    {
      "cue": 1,
      "start": 0.0,
      "end": 3.15,
      "text": "Calls Summary gives a supervisor a compact view of the"
    },
    {
      "cue": 2,
      "start": 3.15,
      "end": 5.0,
      "text": "department's active-call workload."
    },
    {
      "cue": 3,
      "start": 5.449,
      "end": 8.899000000000001,
      "text": "In the open Add Widget panel, choose Calls Summary."
    },
    {
      "cue": 4,
      "start": 9.34,
      "end": 13.27,
      "text": "This example uses four fictional calls and the department's Routine,"
    },
    {
      "cue": 5,
      "start": 13.46,
      "end": 15.51,
      "text": "Urgent and Emergency priorities."
    },
    {
      "cue": 6,
      "start": 15.939,
      "end": 19.92,
      "text": "A shared display can help the coordination team notice workload, then"
    },
    {
      "cue": 7,
      "start": 19.92,
      "end": 23.53,
      "text": "turn to the detailed calls list for the incident names and assignments."
    },
    {
      "cue": 8,
      "start": 23.979,
      "end": 26.969,
      "text": "Use a training department when practicing changes to the board."
    },
    {
      "cue": 9,
      "start": 27.12,
      "end": 30.59,
      "text": "Use the gear icon at the upper right to open configuration,"
    },
    {
      "cue": 10,
      "start": 30.879,
      "end": 33.069,
      "text": "then select Calls Summary Widget."
    },
    {
      "cue": 11,
      "start": 33.489,
      "end": 36.93,
      "text": "Keep Show Recent Call and Show Priority Counts on."
    },
    {
      "cue": 12,
      "start": 37.34,
      "end": 39.67,
      "text": "Set Max Priorities to Show to All."
    },
    {
      "cue": 13,
      "start": 40.05,
      "end": 44.21,
      "text": "This first view uses Font Size at fourteen points, width four"
    },
    {
      "cue": 14,
      "start": 44.3,
      "end": 45.999,
      "text": "and height three grid units."
    },
    {
      "cue": 15,
      "start": 46.339,
      "end": 48.609,
      "text": "Select Save and scroll to the summary."
    },
    {
      "cue": 16,
      "start": 48.97,
      "end": 52.22,
      "text": "Giving the panel enough room keeps the recent-call card and"
    },
    {
      "cue": 17,
      "start": 52.22,
      "end": 54.16,
      "text": "priority rows readable together."
    },
    {
      "cue": 18,
      "start": 54.39,
      "end": 60.24,
      "text": "The summary shows Active four, Routine three, Urgent one and Emergency zero."
    },
    {
      "cue": 19,
      "start": 60.649,
      "end": 63.929,
      "text": "Its recent-call card displays the fictional scheduled community"
    },
    {
      "cue": 20,
      "start": 63.929,
      "end": 67.54,
      "text": "standby that was already dispatched during an earlier exercise."
    },
    {
      "cue": 21,
      "start": 67.889,
      "end": 70.629,
      "text": "The date in its name is a historical training label."
    },
    {
      "cue": 22,
      "start": 71.16,
      "end": 74.41,
      "text": "Scroll to the detailed Calls table and compare the Priority"
    },
    {
      "cue": 23,
      "start": 74.41,
      "end": 78.58,
      "text": "column: three rows are Routine, and the warehouse alarm is Urgent."
    },
    {
      "cue": 24,
      "start": 78.979,
      "end": 83.369,
      "text": "A priority count summarizes calls; it does not identify which people"
    },
    {
      "cue": 25,
      "start": 83.369,
      "end": 85.399,
      "text": "or units are available to respond."
    },
    {
      "cue": 26,
      "start": 85.65,
      "end": 90.46,
      "text": "Return to Calls Summary Widget and change Max Priorities to Show to one."
    },
    {
      "cue": 27,
      "start": 90.969,
      "end": 93.179,
      "text": "Select Save and inspect the board again."
    },
    {
      "cue": 28,
      "start": 93.669,
      "end": 97.749,
      "text": "Only the Routine row, with three calls, remains in the priority section."
    },
    {
      "cue": 29,
      "start": 98.179,
      "end": 99.749,
      "text": "Active still shows four."
    },
    {
      "cue": 30,
      "start": 100.16,
      "end": 104.97,
      "text": "This option limits how many priority rows the panel displays; it does not close,"
    },
    {
      "cue": 31,
      "start": 105.05,
      "end": 107.63,
      "text": "remove or filter the underlying calls."
    },
    {
      "cue": 32,
      "start": 107.979,
      "end": 112.149,
      "text": "A restricted display can therefore omit an urgent category even while its"
    },
    {
      "cue": 33,
      "start": 112.149,
      "end": 114.14,
      "text": "call still contributes to the total."
    },
    {
      "cue": 34,
      "start": 114.24,
      "end": 118.039,
      "text": "For a count-focused display, return Max Priorities to Show to"
    },
    {
      "cue": 35,
      "start": 118.069,
      "end": 122.719,
      "text": "All, turn Show Recent Call off and keep Show Priority Counts on."
    },
    {
      "cue": 36,
      "start": 123.189,
      "end": 127.029,
      "text": "Increase Font Size to sixteen points, then select Save."
    },
    {
      "cue": 37,
      "start": 127.45,
      "end": 131.629,
      "text": "The board now shows Active four and all three priority rows without the"
    },
    {
      "cue": 38,
      "start": 131.629,
      "end": 133.42,
      "text": "recent-call name and address card."
    },
    {
      "cue": 39,
      "start": 133.78,
      "end": 135.77,
      "text": "This changes the summary presentation."
    },
    {
      "cue": 40,
      "start": 136.1,
      "end": 138.889,
      "text": "The detailed calls remain available elsewhere on the board."
    },
    {
      "cue": 41,
      "start": 139.34,
      "end": 142.959,
      "text": "Choose a text size that people can read from the actual viewing distance."
    },
    {
      "cue": 42,
      "start": 143.069,
      "end": 146.579,
      "text": "Turn Show Priority Counts off as well and select Save."
    },
    {
      "cue": 43,
      "start": 147.03,
      "end": 151.729,
      "text": "With both optional sections hidden, the Calls panel contains just Active four."
    },
    {
      "cue": 44,
      "start": 152.13,
      "end": 155.79,
      "text": "The compact total may suit a secondary display, but viewers"
    },
    {
      "cue": 45,
      "start": 155.79,
      "end": 159.41,
      "text": "can no longer see the workload's priority distribution in that panel."
    },
    {
      "cue": 46,
      "start": 159.749,
      "end": 163.449,
      "text": "Hiding information does not make its underlying incidents disappear."
    },
    {
      "cue": 47,
      "start": 163.779,
      "end": 168.05,
      "text": "Decide what your coordination team needs to see before adopting this minimal view."
    },
    {
      "cue": 48,
      "start": 168.349,
      "end": 173.1,
      "text": "Restore Show Recent Call and Show Priority Counts, leave Max Priorities"
    },
    {
      "cue": 49,
      "start": 173.1,
      "end": 175.39,
      "text": "to Show at All, and select Save."
    },
    {
      "cue": 50,
      "start": 175.93,
      "end": 178.689,
      "text": "Reload the board and inspect the complete summary again."
    },
    {
      "cue": 51,
      "start": 179.2,
      "end": 184.35,
      "text": "Active remains four, with Routine three, Urgent one and Emergency zero."
    },
    {
      "cue": 52,
      "start": 184.889,
      "end": 189.969,
      "text": "Reopen Calls Summary Widget to read back both enabled switches, All, Font Size"
    },
    {
      "cue": 53,
      "start": 189.969,
      "end": 192.61,
      "text": "sixteen and the four-by-three dimensions."
    },
    {
      "cue": 54,
      "start": 193.1,
      "end": 197.61,
      "text": "Checking the saved controls as well as the visible result confirms the configuration"
    },
    {
      "cue": 55,
      "start": 197.61,
      "end": 199.379,
      "text": "the display is actually using."
    },
    {
      "cue": 56,
      "start": 199.629,
      "end": 203.699,
      "text": "These display choices also fit departments beyond fire and E M S."
    },
    {
      "cue": 57,
      "start": 204.119,
      "end": 207.669,
      "text": "Security teams can summarize service calls and patrol incidents."
    },
    {
      "cue": 58,
      "start": 208.07,
      "end": 211.27,
      "text": "Search-and-rescue coordinators can monitor their mission workload."
    },
    {
      "cue": 59,
      "start": 211.669,
      "end": 215.27,
      "text": "Community paramedicine and mental health response teams, wildland"
    },
    {
      "cue": 60,
      "start": 215.27,
      "end": 219.28,
      "text": "contractors and industrial emergency response teams can use their own"
    },
    {
      "cue": 61,
      "start": 219.28,
      "end": 221.03,
      "text": "call priorities in the same way."
    },
    {
      "cue": 62,
      "start": 221.46,
      "end": 225.089,
      "text": "Keep the full category view when every priority matters, and"
    },
    {
      "cue": 63,
      "start": 225.089,
      "end": 228.6,
      "text": "consult the detailed Calls table when a count needs investigation."
    }
  ],
