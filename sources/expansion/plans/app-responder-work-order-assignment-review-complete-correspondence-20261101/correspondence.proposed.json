      "cue": 13,
      "scene_id": "02",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [],
      "spoken_references": {},
      "instructional": false
    },
    {
      "start": 46.269,
      "end": 49.589,
      "text": "Read the action you intend to take rather than using a status",
