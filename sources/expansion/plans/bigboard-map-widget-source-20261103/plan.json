      }
    },
    {
      "id": "02",
      "title": "Choose visible pin types",
      "kind": "operational",
      "start": 34.999,
      "end": 50.96,
      "screens": [
        {
          "screenshot_id": "003-hide-call-pins-keep-operational-reference",
          "start": 34.999,
          "end": 42.13
        },
        {
          "screenshot_id": "004-map-with-calls-hidden",
          "start": 42.13,
          "end": 50.96
        }
      ],
      "captions": [
        {
          "start": 34.999,
          "end": 39.49,
          "text": "Turn off Show Calls and leave stations, units, and personnel enabled.",
          "cue": 11,
          "screenshot_id": "003-hide-call-pins-keep-operational-reference",
          "required_labels": [
            "Show Calls"
          ],
          "instructional": true,
          "spoken_references": {
            "Show Calls": "Show Calls"
          }
        },
        {
          "start": 39.909,
          "end": 41.729,
          "text": "Save, then return to the map.",
          "cue": 12,
          "screenshot_id": "003-hide-call-pins-keep-operational-reference",
          "required_labels": [
            "Save"
          ],
          "instructional": true,
          "spoken_references": {
            "Save": "Save"
          }
        },
        {
          "start": 42.13,
          "end": 45.27,
          "text": "The training call pins are gone while the other references remain.",
          "cue": 13,
          "screenshot_id": "004-map-with-calls-hidden",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 45.59,
          "end": 47.55,
          "text": "This is a display preference for the widget.",
          "cue": 14,
          "screenshot_id": "004-map-with-calls-hidden",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 47.829,
          "end": 50.85,
          "text": "It does not close any calls or remove assignments.",
          "cue": 15,
          "screenshot_id": "004-map-with-calls-hidden",
          "required_labels": [],
          "instructional": false
        }
      ],
      "visual_required_labels": [
        "Show Calls",
        "Save"
      ],
      "instruction_review": {
        "reviewer": "Root",
        "reviewed_at": "2026-11-03T18:58:58.260826+00:00",
        "passed": true,
