      "scene_id": "02",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [],
      "spoken_references": {},
      "instructional": false
    },
    {
      "start": 49.619,
      "end": 52.759,
      "text": "or time entry as a substitute for accepting the right work. The",
      "cue": 15,
      "scene_id": "02",
      "screenshot_id": "190-assigned-order-before-acceptance",
      "required_labels": [],
      "spoken_references": {},
      "instructional": false
    },
    {
