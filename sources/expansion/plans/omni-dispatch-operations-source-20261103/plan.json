      "captions": [
        {
          "start": 0.079,
          "end": 2.18,
          "text": "Open Deployments in Omni Dispatch.",
          "cue": 1,
          "screenshot_id": "001-open-deployments",
          "required_labels": [
            "Deployments"
          ],
          "instructional": true,
          "spoken_references": {
            "Deployments": "Deployments"
          }
        },
        {
          "start": 2.6189999999999998,
          "end": 6.199,
          "text": "The Open filter gives you the deployments that are still in progress.",
          "cue": 2,
          "screenshot_id": "001-open-deployments",
          "required_labels": [
            "Open"
          ],
          "instructional": true,
          "spoken_references": {
            "Open": "Open"
          }
        },
        {
          "start": 6.639,
          "end": 9.76,
          "text": "Select Community support deployment and check its status",
          "cue": 3,
          "screenshot_id": "002-deployment-detail",
          "required_labels": [
            "TRAINING ONLY - Community support deployment"
          ],
          "instructional": true,
          "spoken_references": {
            "TRAINING ONLY - Community support deployment": "Community support deployment"
          }
        },
        {
          "start": 9.789,
          "end": 11.21,
          "text": "and assigned resource counts.",
          "cue": 4,
          "screenshot_id": "002-deployment-detail",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 11.619,
          "end": 14.72,
          "text": "A wildland contractor could use this view to confirm which",
          "cue": 5,
          "screenshot_id": "002-deployment-detail",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 14.72,
          "end": 16.53,
          "text": "deployment a crew is working under.",
          "cue": 6,
          "screenshot_id": "002-deployment-detail",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 16.759,
          "end": 19.809,
          "text": "Use Previous day to move to the day you are reviewing.",
          "cue": 7,
          "screenshot_id": "002-deployment-detail",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 20.309,
          "end": 23.189,
          "text": "This exercise has a crew report on November second.",
          "cue": 8,
          "screenshot_id": "003-deployment-day-approved-report",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 23.609,
          "end": 26.6,
          "text": "Reports this day shows that the entry is Approved and",
          "cue": 9,
          "screenshot_id": "003-deployment-day-approved-report",
          "required_labels": [
            "Reports this day"
          ],
          "instructional": true,
          "spoken_references": {
            "Reports this day": "Reports this day"
          }
        },
        {
          "start": 26.6,
          "end": 28.549,
          "text": "totals eleven and a half hours.",
          "cue": 10,
          "screenshot_id": "003-deployment-day-approved-report",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 28.949,
          "end": 33.15,
          "text": "Open the report to check the individual entries and their time ranges and breaks.",
          "cue": 11,
          "screenshot_id": "004-approved-crew-report",
