+import React from 'react';
+
+export interface WebCameraSettings {
+  centerCoordinate?: number[];
+  zoomLevel?: number;
+  heading?: number;
+  pitch?: number;
+}
+
+export interface WebCameraDeclaration extends WebCameraSettings {
+  defaultSettings?: WebCameraSettings;
+  followUserLocation?: boolean;
+  followZoomLevel?: number;
+}
+
+export interface ExistingLocation {
+  latitude: number | null;
+  longitude: number | null;
+}
+
+export function resolveWebCameraSettings(props: WebCameraDeclaration, location?: ExistingLocation): WebCameraSettings {
+  const defaults = props.defaultSettings ?? {};
+  const followsExistingFix = props.followUserLocation && location?.latitude != null && location?.longitude != null
+    && Number.isFinite(location.latitude) && Math.abs(location.latitude) <= 90
+    && Number.isFinite(location.longitude) && Math.abs(location.longitude) <= 180;
+  return {
+    centerCoordinate: followsExistingFix ? [location!.longitude!, location!.latitude!] : props.centerCoordinate ?? defaults.centerCoordinate,
+    zoomLevel: followsExistingFix ? props.followZoomLevel ?? props.zoomLevel ?? defaults.zoomLevel : props.zoomLevel ?? defaults.zoomLevel,
+    heading: props.heading ?? defaults.heading,
+    pitch: props.pitch ?? defaults.pitch,
+  };
+}
+
+export function findWebCameraDeclaration(children: React.ReactNode, cameraType: React.ElementType): WebCameraDeclaration | undefined {
+  for (const child of React.Children.toArray(children)) {
+    if (!React.isValidElement<WebCameraDeclaration & { children?: React.ReactNode }>(child)) continue;
+    if (child.type === cameraType) return child.props;
+    const nested = findWebCameraDeclaration(child.props.children, cameraType);
+    if (nested) return nested;
+  }
+  return undefined;
+}
+
+export function initialWebMapOptions(styleURL: string | undefined, camera: WebCameraSettings,
+  department: { latitude: number; longitude: number; zoomLevel: number }) {
+  return {
+    style: styleURL,
+    center: (camera.centerCoordinate ?? [department.longitude, department.latitude]).slice(0, 2) as [number, number],
+    zoom: camera.zoomLevel ?? department.zoomLevel,
+    bearing: camera.heading ?? 0,
+    pitch: camera.pitch ?? 0,
+  };
+}
+
+// Translate real Mapbox browser events into the existing app callback shapes.
+// No completion callback fires merely because a component mounted.
+export function bindWebMapEvents(map: any, readProps: () => any) {
+  const bindings: [string, (event: any) => void][] = [
+    ['load', (event) => readProps().onDidFinishLoadingMap?.(event)],
+    ['move', (event) => readProps().onCameraChanged?.({
+      properties: { center: [map.getCenter().lng, map.getCenter().lat], zoom: map.getZoom(),
+        heading: map.getBearing(), pitch: map.getPitch(), isUserInteraction: !!event?.originalEvent },
+    })],
+    ['idle', (event) => readProps().onMapIdle?.(event)],
+    ['click', (event) => readProps().onPress?.({
+      geometry: { type: 'Point', coordinates: [event.lngLat.lng, event.lngLat.lat] },
+      properties: {},
+    })],
+  ];
+  // Leave the SDK's default error reporting intact when the source has no handler.
+  if (readProps().onMapLoadingError) bindings.push(['error', (event) => readProps().onMapLoadingError?.(event)]);
+  for (const [name, handler] of bindings) map.on(name, handler);
+  return () => { for (const [name, handler] of bindings) map.off(name, handler); };
+}
