    {
      "id": "01",
      "title": "What a unit timer measures",
      "kind": "operational",
      "start": 0.0,
      "end": 21.84,
      "screens": [
        {
          "screenshot_id": "006-live-one-minute-warning",
          "start": 0.0,
          "end": 14.818999999999999
        },
        {
          "screenshot_id": "014-mute-expired-automatically-acknowledgement-retained",
          "start": 14.818999999999999,
          "end": 17.44
        },
        {
          "screenshot_id": "025-warning-mute-overridden-at-four-minute-alert",
          "start": 17.44,
          "end": 21.84
        }
      ],
      "captions": [
        {
          "start": 0.029,
          "end": 3.98,
          "text": "A unit timer answers a simple question: how long has this",
          "cue": 1,
          "screenshot_id": "006-live-one-minute-warning",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 3.98,
          "end": 5.84,
          "text": "unit been in its current status?",
          "cue": 2,
          "screenshot_id": "006-live-one-minute-warning",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 6.32,
          "end": 10.25,
          "text": "Big Board can show a warning, then an alert, when a unit stays there",
          "cue": 3,
          "screenshot_id": "006-live-one-minute-warning",
          "required_labels": [
            "Staging"
          ],
          "instructional": true,
          "spoken_references": {
            "Staging": "a unit stays there"
          }
        },
        {
          "start": 10.25,
          "end": 12.289,
          "text": "past the times your department sets.",
          "cue": 4,
          "screenshot_id": "006-live-one-minute-warning",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 12.72,
          "end": 14.43,
          "text": "We will compare two outcomes.",
          "cue": 5,
          "screenshot_id": "006-live-one-minute-warning",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 14.818999999999999,
          "end": 17.01,
          "text": "First, a mute ends on its own.",
          "cue": 6,
          "screenshot_id": "014-mute-expired-automatically-acknowledgement-retained",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 17.44,
          "end": 21.719,
          "text": "Then a warning becomes an alert while its mute still has time left.",
          "cue": 7,
          "screenshot_id": "025-warning-mute-overridden-at-four-minute-alert",
          "required_labels": [],
          "instructional": false
        }
      ],
      "visual_required_labels": [
        "Staging"
      ],
