      "captions": [
        {
          "start": 148.589,
          "end": 151.379,
          "text": "When the new amber warning appears, open its row.",
          "cue": 47,
          "screenshot_id": "020-fresh-warning-at-one-minute",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 151.829,
          "end": 155.65,
          "text": "Choose fifteen minutes, enter a reason, and select Mute.",
          "cue": 48,
          "screenshot_id": "021-prepare-warning-mute-with-reason",
          "required_labels": [
            "Mute"
          ],
          "instructional": true,
          "spoken_references": {
            "Mute": "select Mute"
          }
        },
        {
          "start": 156.159,
          "end": 158.58,
          "text": "Expand Muted to check the saved result.",
          "cue": 49,
          "screenshot_id": "022-warning-is-muted-before-escalation",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 158.959,
          "end": 161.099,
          "text": "The sheet shows a future mute deadline.",
          "cue": 50,
          "screenshot_id": "023-warning-mute-deadline-retained",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 161.53,
          "end": 165.049,
          "text": "At three minutes the warning is still in the Muted section, so",
          "cue": 51,
          "screenshot_id": "024-warning-still-muted-at-three-minutes",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 165.049,
          "end": 166.549,
          "text": "we know the mute took effect.",
          "cue": 52,
          "screenshot_id": "024-warning-still-muted-at-three-minutes",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 166.749,
          "end": 170.519,
          "text": "At four minutes, the same unit returns as a red alert even though",
          "cue": 53,
          "screenshot_id": "025-warning-mute-overridden-at-four-minute-alert",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 170.519,
          "end": 172.18,
          "text": "the warning mute has time left.",
          "cue": 54,
          "screenshot_id": "025-warning-mute-overridden-at-four-minute-alert",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 172.58,
          "end": 175.909,
          "text": "Its earlier Seen by line no longer covers this alert.",
          "cue": 55,
          "screenshot_id": "025-warning-mute-overridden-at-four-minute-alert",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 176.339,
          "end": 179.369,
          "text": "Big Board treats the higher level as a new item to review.",
          "cue": 56,
          "screenshot_id": "026-escalated-alert-awaits-new-acknowledgement",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 179.789,
          "end": 183.23,
          "text": "Acknowledge it only after checking what is happening with that unit.",
          "cue": 57,
          "screenshot_id": "026-escalated-alert-awaits-new-acknowledgement",
          "required_labels": [
            "Acknowledge"
          ],
          "instructional": true,
          "spoken_references": {
            "Acknowledge": "Acknowledge"
          }
        },
        {
          "start": 183.389,
          "end": 186.869,
          "text": "A community paramedicine team could use this to notice a vehicle",
          "cue": 58,
          "screenshot_id": "025-warning-mute-overridden-at-four-minute-alert",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 186.869,
          "end": 188.3,
          "text": "waiting at a staging point.",
          "cue": 59,
          "screenshot_id": "025-warning-mute-overridden-at-four-minute-alert",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 188.72,
          "end": 192.149,
          "text": "A search and rescue team could watch a resource waiting at a trailhead,",
          "cue": 60,
          "screenshot_id": "025-warning-mute-overridden-at-four-minute-alert",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 192.49,
          "end": 196.389,
          "text": "while industrial response or security teams could use their own status",
          "cue": 61,
          "screenshot_id": "025-warning-mute-overridden-at-four-minute-alert",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 196.389,
          "end": 198.61,
          "text": "meanings and realistic follow-up times.",
          "cue": 62,
          "screenshot_id": "025-warning-mute-overridden-at-four-minute-alert",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 199.089,
          "end": 203.55,
          "text": "Start with a training unit, confirm each transition, and agree who checks",
          "cue": 63,
          "screenshot_id": "026-escalated-alert-awaits-new-acknowledgement",
          "required_labels": [],
          "instructional": false
        },
        {
          "start": 203.55,
          "end": 205.189,
          "text": "an alert and records the reason.",
          "cue": 64,
          "screenshot_id": "026-escalated-alert-awaits-new-acknowledgement",
          "required_labels": [],
          "instructional": false
        }
      ],
